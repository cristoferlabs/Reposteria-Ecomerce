---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---

<BaseLayout title={`Página no encontrada — ${siteConfig.name}`}>
  <main class="flex flex-col items-center justify-center px-6 py-24 text-center">
    <p class="font-display text-6xl font-semibold text-pink-strong">404</p>
    <h1 class="mt-4 font-display text-2xl font-semibold text-charcoal">
      No encontramos esta página
    </h1>
    <p class="mt-2 max-w-md text-charcoal/70">
      Puede que el enlace esté roto o el producto ya no esté disponible.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-pink-strong px-8 py-3 font-body text-sm font-semibold text-white transition-colors hover:bg-charcoal"
    >
      Volver al inicio
    </a>
  </main>
</BaseLayout>
