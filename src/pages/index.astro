---
import { eq } from "drizzle-orm";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import CategoryTiles from "../components/home/CategoryTiles.astro";
import PromoSplit from "../components/home/PromoSplit.astro";
import FeaturedGrid from "../components/home/FeaturedGrid.astro";
import ReviewsCarousel from "../components/home/ReviewsCarousel.astro";
import { db } from "../db/client";
import { products } from "../db/schema";
import { formatSoles } from "../lib/orders/pricing";
import { siteConfig } from "../config/site";

const featuredProducts = await db.query.products.findMany({
  where: eq(products.featured, true),
  orderBy: (products, { asc }) => [asc(products.name)],
  with: { variants: true },
});

const featured = featuredProducts.map((product) => ({
  productId: product.id,
  name: product.name,
  priceLabel: formatSoles(product.basePriceCents),
  basePriceCents: product.basePriceCents,
  image: product.imageUrl,
  href: `/producto/${product.slug}`,
  description: product.description,
  variants: product.variants
    .filter((v) => v.active)
    .sort((a, b) => a.sortOrder - b.sortOrder)
    .map((v) => ({ id: v.id, name: v.name, priceDeltaCents: v.priceDeltaCents })),
  leadTimeDays: product.leadTimeDays,
  allowsUrgent: product.allowsUrgent,
  hasVariants: product.variants.some((v) => v.active),
}));

const promoProducts = featuredProducts.slice(0, 2).map((product) => ({
  name: product.name,
  description: product.description,
  image: product.imageUrl,
  href: `/producto/${product.slug}`,
}));
---

<BaseLayout title={`${siteConfig.name} — ${siteConfig.tagline}`} transparentNavbar>
  <Hero />
  <CategoryTiles />
  <PromoSplit products={promoProducts} />
  {featured.length > 0 && <FeaturedGrid title="Destacados" items={featured} />}
  <ReviewsCarousel />
</BaseLayout>
