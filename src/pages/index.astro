---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryShowcase from "../components/home/CategoryShowcase.astro";
import { siteConfig } from "../config/site";

// Home = solo la pantalla inicial (nav + hero). Sin trust band ni footer.
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  showIntro
  transparentNavbar
  showFooter={false}
>
  <CategoryShowcase slot="canvas" />
</BaseLayout>
