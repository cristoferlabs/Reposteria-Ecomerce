---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getSessionUser, isAdminEmail } from "../../../lib/auth";
import { fetchJson, internalApiUrl } from "../../../lib/http/fetchJson";

const session = getSessionUser(Astro.request);
if (!session) {
  return Astro.redirect("/cuenta/acceso?redirect=" + encodeURIComponent("/admin/resenas"));
}
if (!isAdminEmail(session.email)) {
  return Astro.rewrite("/404");
}

interface AdminReview {
  id: number;
  rating: number;
  comment: string | null;
  approved: boolean;
  createdAt: string;
  customerName: string;
  productName: string;
}

// GET /api/admin/resenas todavía no existe del lado del backend (pedido
// pendiente) — degrada a un aviso en vez de romper la página.
let reviews: AdminReview[] = [];
let loadError = false;
try {
  const data = await fetchJson<{ reviews: AdminReview[] }>(internalApiUrl("/api/admin/resenas"), {
    headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
  });
  reviews = data.reviews;
} catch {
  loadError = true;
}

const pending = reviews.filter((r) => !r.approved);
const approved = reviews.filter((r) => r.approved);
---

<AdminLayout title="Reseñas">
  <h1 class="font-display text-2xl font-semibold text-charcoal">Reseñas</h1>
  <p class="mt-1 text-sm text-charcoal/60">Aprobá o rechazá las reseñas antes de que se publiquen en cada producto.</p>

  {
    loadError ? (
      <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        Esta sección todavía no está disponible — falta que el backend agregue el endpoint de moderación.
      </div>
    ) : (
      <>
        <p id="review-action-error" class="mt-4 hidden rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-600" />

        <h2 class="mt-8 font-body text-sm font-semibold text-charcoal">Pendientes ({pending.length})</h2>
        {pending.length === 0 ? (
          <p class="mt-3 text-sm text-charcoal/50">No hay reseñas pendientes de revisión.</p>
        ) : (
          <ul class="mt-3 space-y-3">
            {pending.map((r) => (
              <li data-review-row data-id={r.id} class="rounded-lg border border-charcoal/10 bg-white p-4">
                <div class="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p class="font-body text-sm font-semibold text-charcoal">
                      {r.productName} · {r.customerName}
                    </p>
                    <div class="mt-1 flex text-gold" aria-hidden="true">
                      {Array.from({ length: 5 }).map((_, i) => (
                        <svg viewBox="0 0 20 20" fill={i < r.rating ? "currentColor" : "none"} stroke="currentColor" class="h-4 w-4">
                          <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L10 1.5z" stroke-linejoin="round" />
                        </svg>
                      ))}
                    </div>
                    {r.comment && <p class="mt-2 text-sm text-charcoal/80">"{r.comment}"</p>}
                    <p class="mt-1 text-xs text-charcoal/50">
                      {new Date(r.createdAt).toLocaleDateString("es-PE", { dateStyle: "medium" })}
                    </p>
                  </div>
                  <div class="flex shrink-0 gap-2">
                    <button
                      type="button"
                      data-action="approve"
                      class="rounded-full bg-pink-strong px-4 py-1.5 font-body text-xs font-semibold text-white transition-colors hover:bg-charcoal"
                    >
                      Aprobar
                    </button>
                    <button
                      type="button"
                      data-action="reject"
                      class="rounded-full border border-charcoal/20 px-4 py-1.5 font-body text-xs font-semibold text-charcoal transition-colors hover:bg-charcoal/5"
                    >
                      Rechazar
                    </button>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )}

        <h2 class="mt-10 font-body text-sm font-semibold text-charcoal">Aprobadas ({approved.length})</h2>
        {approved.length === 0 ? (
          <p class="mt-3 text-sm text-charcoal/50">Todavía no hay reseñas aprobadas.</p>
        ) : (
          <ul class="mt-3 space-y-2">
            {approved.map((r) => (
              <li class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-charcoal/10 bg-white px-4 py-3 text-sm">
                <span class="text-charcoal">
                  {r.productName} · {r.customerName} · {r.rating}★
                </span>
                <span class="text-xs text-charcoal/50">
                  {new Date(r.createdAt).toLocaleDateString("es-PE", { dateStyle: "medium" })}
                </span>
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }
</AdminLayout>

<script>
  import { fetchJson } from "../../../lib/http/fetchJson";

  const errorEl = document.getElementById("review-action-error");
  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }

  document.querySelectorAll<HTMLElement>("[data-review-row]").forEach((row) => {
    const id = row.dataset.id;

    row.querySelector('[data-action="approve"]')?.addEventListener("click", async (event) => {
      const btn = event.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      errorEl?.classList.add("hidden");
      try {
        await fetchJson(`/api/admin/resenas/${id}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ approved: true }),
        });
        window.location.reload();
      } catch (err) {
        showError(err instanceof Error ? err.message : "No se pudo aprobar la reseña.");
        btn.disabled = false;
      }
    });

    row.querySelector('[data-action="reject"]')?.addEventListener("click", async (event) => {
      if (!confirm("¿Rechazar y eliminar esta reseña?")) return;
      const btn = event.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      errorEl?.classList.add("hidden");
      try {
        await fetchJson(`/api/admin/resenas/${id}`, { method: "DELETE" });
        window.location.reload();
      } catch (err) {
        showError(err instanceof Error ? err.message : "No se pudo rechazar la reseña.");
        btn.disabled = false;
      }
    });
  });
</script>
