---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import OrderStatusStepper from "../../../components/order/OrderStatusStepper.astro";
import OrderItemsList from "../../../components/order/OrderItemsList.astro";
import PaymentSummary from "../../../components/order/PaymentSummary.astro";
import PaymentsHistoryList from "../../../components/admin/PaymentsHistoryList.astro";
import { getSessionUser, isAdminEmail } from "../../../lib/auth";
import { canTransition } from "../../../lib/orders/stateMachine";
import { fetchJson, internalApiUrl } from "../../../lib/http/fetchJson";
import { STATUS_LABELS } from "../../../lib/orders/orderStatusMeta";
import type { DeliveryMethod, OrderStatus } from "../../../db/schema";

const { publicId } = Astro.params;
const session = getSessionUser(Astro.request);

if (!session) {
  return Astro.redirect(
    "/cuenta/acceso?redirect=" + encodeURIComponent(`/admin/solicitudes/${publicId}`),
  );
}
if (!isAdminEmail(session.email)) {
  return Astro.rewrite("/404");
}

interface OrderItem {
  quantity: number;
  unitPriceCents: number;
  customizationNotes: string | null;
  product: { name: string; imageUrl: string };
  variant: { name: string } | null;
}

interface StatusHistoryEntry {
  fromStatus: OrderStatus | null;
  toStatus: OrderStatus;
  note: string | null;
  createdAt: string;
  changedBy: { name: string } | null;
}

interface Payment {
  id: number;
  type: "inicial" | "final";
  amountCents: number;
  method: string;
  status: string;
  mpPaymentId: string | null;
  createdAt: string;
}

interface OrderDetail {
  publicId: string;
  status: OrderStatus;
  desiredDate: string;
  isUrgent: boolean;
  customerNotes: string | null;
  adminNotes: string | null;
  rejectedReason: string | null;
  subtotalCents: number;
  urgencySurchargeCents: number;
  deliveryCostCents: number;
  deliveryMethod: DeliveryMethod | null;
  totalCents: number;
  initialPaymentCents: number;
  finalPaymentCents: number;
  finalPaymentCollected: boolean;
  items: OrderItem[];
  statusHistory: StatusHistoryEntry[];
  payments: Payment[];
  customer: { name: string; email: string };
  // Todavía no lo persiste el backend (migración pendiente) — el frontend ya
  // queda listo para mostrarlo apenas exista.
  customerPhone?: string | null;
}

let order: OrderDetail;
try {
  const data = await fetchJson<{ order: OrderDetail }>(
    internalApiUrl(`/api/admin/solicitudes/${publicId}`),
    { headers: { cookie: Astro.request.headers.get("cookie") ?? "" } },
  );
  order = data.order;
} catch {
  return Astro.rewrite("/404");
}

const canTake = canTransition(order.status, "tomado", "admin");
const canPropose = canTransition(order.status, "ajustes_propuestos", "admin");
const canReject = canTransition(order.status, "rechazado", "admin");
const canCancel = canTransition(order.status, "cancelado", "admin");

const PRODUCTION_STEPS: Partial<Record<OrderStatus, OrderStatus>> = {
  pago_inicial_confirmado: "en_preparacion",
  en_preparacion: "listo",
  listo: "entregado",
};
const PRODUCTION_LABELS: Record<string, string> = {
  en_preparacion: "Comenzar preparación",
  listo: "Marcar como listo",
  entregado: "Marcar como entregado",
};
const nextProductionStatus = PRODUCTION_STEPS[order.status] ?? null;
const canAdvance = nextProductionStatus ? canTransition(order.status, nextProductionStatus, "admin") : false;

const canRegisterFinalPayment =
  order.status === "listo" && order.deliveryMethod === "contraentrega" && !order.finalPaymentCollected;
---

<AdminLayout title={`Pedido ${order.publicId}`}>
  <a href="/admin/solicitudes" class="text-sm text-charcoal/60 hover:text-pink-strong">&larr; Volver a solicitudes</a>

  <div class="mt-3 flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm text-charcoal/60">Pedido #{order.publicId}</p>
      <h1 class="mt-1 font-display text-2xl font-semibold text-charcoal">{STATUS_LABELS[order.status]}</h1>
    </div>
    <div class="text-right text-sm">
      <p class="font-medium text-charcoal">{order.customer.name}</p>
      <p class="text-charcoal/60">{order.customer.email}</p>
      {
        order.customerPhone && (
          <a
            href={`https://wa.me/${order.customerPhone.replace(/\D/g, "")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-emerald-600 hover:underline"
          >
            {order.customerPhone} · WhatsApp
          </a>
        )
      }
    </div>
  </div>

  <div class="mt-8 rounded-lg border border-charcoal/10 bg-white p-4">
    <OrderStatusStepper status={order.status} statusHistory={order.statusHistory} rejectedReason={order.rejectedReason} />
  </div>

  <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2 rounded-lg border border-charcoal/10 bg-white p-4">
      <h2 class="font-body text-sm font-semibold text-charcoal">Productos</h2>
      <div class="mt-3">
        <OrderItemsList items={order.items} />
      </div>

      {
        (order.customerNotes || order.adminNotes) && (
          <div class="mt-6 space-y-3 border-t border-charcoal/10 pt-6">
            {order.customerNotes && (
              <div>
                <p class="text-xs font-semibold tracking-wide text-charcoal/50 uppercase">Notas del cliente</p>
                <p class="mt-1 text-sm text-charcoal">{order.customerNotes}</p>
              </div>
            )}
            {order.adminNotes && (
              <div>
                <p class="text-xs font-semibold tracking-wide text-charcoal/50 uppercase">Notas del repostero</p>
                <p class="mt-1 text-sm text-charcoal">{order.adminNotes}</p>
              </div>
            )}
          </div>
        )
      }

      <div class="mt-6 border-t border-charcoal/10 pt-6">
        <h2 class="font-body text-sm font-semibold text-charcoal">Pagos</h2>
        <div class="mt-3">
          <PaymentsHistoryList payments={order.payments} />
        </div>
      </div>
    </div>

    <div class="rounded-lg border border-charcoal/10 bg-white p-4">
      <h2 class="font-body text-sm font-semibold text-charcoal">Resumen</h2>
      <div class="mt-3">
        <PaymentSummary
          subtotalCents={order.subtotalCents}
          urgencySurchargeCents={order.urgencySurchargeCents}
          deliveryCostCents={order.deliveryCostCents}
          deliveryMethod={order.deliveryMethod}
          totalCents={order.totalCents}
          initialPaymentCents={order.initialPaymentCents}
          finalPaymentCents={order.finalPaymentCents}
          finalPaymentCollected={order.finalPaymentCollected}
          status={order.status}
        />
      </div>
      <dl class="mt-4 space-y-1 border-t border-charcoal/10 pt-3 text-sm">
        <div class="flex justify-between">
          <dt class="text-charcoal/60">Fecha deseada</dt>
          <dd class="text-charcoal">
            {new Date(order.desiredDate).toLocaleDateString("es-PE", { dateStyle: "medium" })}
            {order.isUrgent && " · urgente"}
          </dd>
        </div>
      </dl>

      <div class="mt-6 space-y-4 border-t border-charcoal/10 pt-6">
        <h2 class="font-body text-sm font-semibold text-charcoal">Acciones</h2>

        {
          canTake && (
            <form data-admin-action="tomar" class="space-y-2">
              <button
                type="submit"
                class="w-full rounded-full bg-pink-strong px-4 py-2 font-body text-sm font-semibold text-white transition-colors hover:bg-charcoal"
              >
                Tomar solicitud
              </button>
              <p class="hidden text-xs text-red-600" data-error />
            </form>
          )
        }

        {
          canPropose && (
            <form data-admin-action="ajustar" class="space-y-2 border-t border-charcoal/10 pt-4 first:border-t-0 first:pt-0">
              <p class="font-body text-xs font-semibold text-charcoal">Proponer ajustes</p>
              <input
                type="number"
                name="urgencySurchargeSoles"
                min="0"
                step="0.01"
                placeholder="Recargo en soles (ej. 15.00)"
                required
                class="w-full rounded-md border border-charcoal/20 px-3 py-1.5 text-sm"
              />
              <textarea
                name="adminNotes"
                rows="2"
                placeholder="Explica las condiciones al cliente"
                required
                class="w-full rounded-md border border-charcoal/20 px-3 py-1.5 text-sm"
              />
              <button
                type="submit"
                class="w-full rounded-full border border-charcoal/20 px-4 py-2 font-body text-sm font-semibold text-charcoal transition-colors hover:bg-charcoal/5"
              >
                Enviar ajustes
              </button>
              <p class="hidden text-xs text-red-600" data-error />
            </form>
          )
        }

        {
          canReject && (
            <form data-admin-action="rechazar" class="space-y-2 border-t border-charcoal/10 pt-4">
              <p class="font-body text-xs font-semibold text-charcoal">Rechazar solicitud</p>
              <textarea
                name="rejectedReason"
                rows="2"
                placeholder="Motivo del rechazo (se lo mostramos al cliente)"
                required
                class="w-full rounded-md border border-charcoal/20 px-3 py-1.5 text-sm"
              />
              <button
                type="submit"
                class="w-full rounded-full border border-red-200 px-4 py-2 font-body text-sm font-semibold text-red-700 transition-colors hover:bg-red-50"
              >
                Rechazar
              </button>
              <p class="hidden text-xs text-red-600" data-error />
            </form>
          )
        }

        {
          canAdvance && nextProductionStatus && (
            <form data-admin-action="avanzar" class="space-y-2 border-t border-charcoal/10 pt-4">
              <input type="hidden" name="to" value={nextProductionStatus} />
              <button
                type="submit"
                class="w-full rounded-full bg-pink-strong px-4 py-2 font-body text-sm font-semibold text-white transition-colors hover:bg-charcoal"
              >
                {PRODUCTION_LABELS[nextProductionStatus]}
              </button>
              <p class="hidden text-xs text-red-600" data-error />
            </form>
          )
        }

        {
          canRegisterFinalPayment && (
            <form data-admin-action="pago-final" class="space-y-2 border-t border-charcoal/10 pt-4">
              <p class="font-body text-xs font-semibold text-charcoal">Registrar pago final (contraentrega)</p>
              <select name="method" required class="w-full rounded-md border border-charcoal/20 px-3 py-1.5 text-sm">
                <option value="efectivo">Efectivo</option>
                <option value="yape">Yape</option>
                <option value="plin">Plin</option>
                <option value="otro">Otro</option>
              </select>
              <input
                type="number"
                name="amountSoles"
                min="0.01"
                step="0.01"
                placeholder={`Monto en soles (por defecto S/ ${(order.finalPaymentCents / 100).toFixed(2)})`}
                class="w-full rounded-md border border-charcoal/20 px-3 py-1.5 text-sm"
              />
              <button
                type="submit"
                class="w-full rounded-full border border-charcoal/20 px-4 py-2 font-body text-sm font-semibold text-charcoal transition-colors hover:bg-charcoal/5"
              >
                Registrar pago
              </button>
              <p class="hidden text-xs text-red-600" data-error />
            </form>
          )
        }

        {
          canCancel && (
            <form data-admin-action="cancelar" class="border-t border-charcoal/10 pt-4">
              <button
                type="submit"
                class="w-full rounded-full border border-charcoal/20 px-4 py-2 font-body text-sm font-semibold text-charcoal/70 transition-colors hover:bg-charcoal/5"
              >
                Cancelar pedido
              </button>
              <p class="hidden text-xs text-red-600" data-error />
            </form>
          )
        }

        {
          !canTake && !canPropose && !canReject && !canAdvance && !canRegisterFinalPayment && !canCancel && (
            <p class="text-sm text-charcoal/50">No hay acciones disponibles para este pedido.</p>
          )
        }
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { fetchJson } from "../../../lib/http/fetchJson";

  const publicId = window.location.pathname.split("/").pop();

  const CONFIRM_MESSAGES: Record<string, string> = {
    rechazar: "¿Seguro que quieres rechazar esta solicitud?",
    cancelar: "¿Seguro que quieres cancelar este pedido?",
  };

  document.querySelectorAll<HTMLFormElement>("[data-admin-action]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const endpoint = form.dataset.adminAction;

      const confirmMsg = endpoint ? CONFIRM_MESSAGES[endpoint] : undefined;
      if (confirmMsg && !confirm(confirmMsg)) return;

      const errorEl = form.querySelector<HTMLElement>("[data-error]");
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      errorEl?.classList.add("hidden");
      if (submitBtn) submitBtn.disabled = true;

      // Los inputs de dinero se muestran/completan en soles (más natural
      // para un usuario no técnico) — se convierten a céntimos enteros acá,
      // justo antes de mandar el payload, para que el contrato con la API
      // (que sigue esperando *Cents) no cambie.
      const formData = new FormData(form);
      const payload: Record<string, unknown> = {};
      for (const [key, value] of formData.entries()) {
        if (typeof value !== "string" || value === "") continue;
        if (key.endsWith("Soles")) {
          payload[key.replace(/Soles$/, "Cents")] = Math.round(Number(value) * 100);
        } else {
          payload[key] = value;
        }
      }

      try {
        await fetchJson(`/api/admin/solicitudes/${publicId}/${endpoint}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        window.location.reload();
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err instanceof Error ? err.message : "No se pudo completar la acción.";
          errorEl.classList.remove("hidden");
        }
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });
</script>
