---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import OrderStatusStepper from "../../../components/order/OrderStatusStepper.astro";
import OrderItemsList from "../../../components/order/OrderItemsList.astro";
import PaymentSummary from "../../../components/order/PaymentSummary.astro";
import DeliveryMethodForm from "../../../components/order/DeliveryMethodForm.astro";
import PaymentReturnBanner from "../../../components/order/PaymentReturnBanner.astro";
import { getSessionUser } from "../../../lib/auth";
import { canTransition } from "../../../lib/orders/stateMachine";
import { fetchJson, internalApiUrl } from "../../../lib/http/fetchJson";
import { STATUS_LABELS } from "../../../lib/orders/orderStatusMeta";
import { siteConfig } from "../../../config/site";
import type { DeliveryMethod, OrderStatus } from "../../../db/schema";

const { publicId } = Astro.params;
const session = getSessionUser(Astro.request);

if (!session) {
  return Astro.redirect(
    "/cuenta/acceso?redirect=" + encodeURIComponent(`/pedido/estado/${publicId}`),
  );
}

interface OrderItem {
  quantity: number;
  unitPriceCents: number;
  customizationNotes: string | null;
  product: { name: string; imageUrl: string };
  variant: { name: string } | null;
}

interface StatusHistoryEntry {
  fromStatus: OrderStatus | null;
  toStatus: OrderStatus;
  note: string | null;
  createdAt: string;
}

interface OrderDetail {
  publicId: string;
  status: OrderStatus;
  desiredDate: string;
  isUrgent: boolean;
  customerNotes: string | null;
  adminNotes: string | null;
  rejectedReason: string | null;
  subtotalCents: number;
  urgencySurchargeCents: number;
  deliveryCostCents: number;
  deliveryMethod: DeliveryMethod | null;
  totalCents: number;
  initialPaymentCents: number;
  finalPaymentCents: number;
  finalPaymentCollected: boolean;
  items: OrderItem[];
  statusHistory: StatusHistoryEntry[];
}

let order: OrderDetail;
let whatsappLink: string | null;

try {
  const data = await fetchJson<{ order: OrderDetail; whatsappLink: string | null }>(
    internalApiUrl(`/api/pedidos/${publicId}`),
    { headers: { cookie: Astro.request.headers.get("cookie") ?? "" } },
  );
  order = data.order;
  whatsappLink = data.whatsappLink;
} catch {
  return Astro.rewrite("/404");
}

const canAcceptAdjustments = canTransition(order.status, "tomado", "cliente");
const canCancel = canTransition(order.status, "cancelado", "cliente");

const mpParam = Astro.url.searchParams.get("collection_status") ?? Astro.url.searchParams.get("status");

// "Paso activo" para el resaltado opcional de bloques en la columna derecha
// (no oculta nada, solo marca con acento cuál sección requiere la próxima
// acción del cliente).
const isDeliveryStepActive = order.status === "tomado";
const isPaymentStepActive = order.status === "pago_inicial_pendiente";

// Copy de guía por estado — no es lógica de dominio (eso vive en
// orderStatusMeta.ts), es solo texto de ayuda para esta página.
const STATUS_HINTS: Partial<Record<OrderStatus, string>> = {
  solicitado: "Tu solicitud está en revisión — te avisamos por WhatsApp en cuanto el repostero la vea.",
  tomado: "¡Tu pedido fue aceptado! Elegí cómo lo vas a recibir para continuar con el pago.",
  pago_inicial_pendiente: "Realizá el pago inicial para que el repostero empiece a preparar tu pedido.",
  pago_inicial_confirmado: "¡Pago confirmado! El repostero va a comenzar a preparar tu pedido pronto.",
  en_preparacion: "Tu pedido se está preparando ahora mismo.",
  listo: "¡Tu pedido está listo! Coordinamos la entrega según el método que elegiste.",
  entregado: "Este pedido ya fue entregado. ¡Gracias por tu compra!",
};
const statusHint = STATUS_HINTS[order.status];
---

<BaseLayout title={`Pedido ${order.publicId} — ${siteConfig.name}`} description="Estado de tu pedido.">
  <div class="mx-auto max-w-6xl px-4 py-10 md:px-6 md:py-16" data-order-status={order.status}>
    <p class="text-sm text-charcoal/60">Pedido #{order.publicId}</p>
    <h1 class="mt-1 font-display text-3xl font-semibold text-charcoal">{STATUS_LABELS[order.status]}</h1>

    <div class="mt-6">
      <PaymentReturnBanner mpParam={mpParam} orderStatus={order.status} />
    </div>

    <div id="update-banner" class="mt-6 hidden items-center justify-between gap-3 rounded-lg border border-pink-strong/30 bg-pink-soft/20 px-4 py-3">
      <p class="font-body text-sm text-charcoal">Tu pedido se actualizó.</p>
      <button
        type="button"
        id="update-banner-refresh"
        class="shrink-0 rounded-full bg-pink-strong px-4 py-1.5 font-body text-xs font-semibold text-white transition-colors hover:bg-charcoal"
      >
        Actualizar
      </button>
    </div>

    <!-- Progreso del pedido: barra horizontal a ancho completo (antes era un
         sidebar vertical, dejaba demasiado espacio en blanco en pantallas anchas) -->
    <div class="mt-8 rounded-lg border border-charcoal/10 bg-white p-4 sm:p-6">
      <OrderStatusStepper status={order.status} statusHistory={order.statusHistory} rejectedReason={order.rejectedReason} />
    </div>

    {
      statusHint && (
        <div class="mt-6 rounded-lg bg-neutral-50 p-4 text-sm text-charcoal/70">
          <p>{statusHint}</p>
        </div>
      )
    }

    {
      order.status === "ajustes_propuestos" && (
        <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4">
          <p class="font-body text-sm font-semibold text-amber-800">El repostero propone ajustes</p>
          {order.urgencySurchargeCents > 0 && (
            <p class="mt-1 text-sm text-amber-800">
              Recargo por urgencia: <strong>{(order.urgencySurchargeCents / 100).toFixed(2)} soles</strong>
            </p>
          )}
          {order.adminNotes && <p class="mt-1 text-sm text-amber-800">"{order.adminNotes}"</p>}
        </div>
      )
    }

    <!-- Contenido: columna principal + resumen fijo al costado en desktop, apilado en mobile -->
    <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_360px]">
      <div class="animate-fade-in-up">
        {order.status === "tomado" && <DeliveryMethodForm publicId={order.publicId} active={isDeliveryStepActive} />}

        {
          order.status === "pago_inicial_pendiente" && (
            <div class="mb-6">
              <button
                type="button"
                id="toggle-change-delivery"
                class="font-body text-sm font-medium text-pink-strong hover:text-charcoal"
              >
                Cambiar método de entrega
              </button>
              <div id="delivery-form-wrapper" class="hidden">
                <DeliveryMethodForm publicId={order.publicId} />
              </div>
            </div>
          )
        }

        <!-- Todo lo demás vive en una sola card en vez de bloques sueltos con
             espacios distintos entre sí. -->
        <div class="rounded-lg border border-charcoal/10 bg-white p-4 sm:p-6">
          <OrderItemsList items={order.items} />

          <dl class="mt-6 space-y-2 border-t border-charcoal/10 pt-6 text-sm">
            <div class="flex justify-between">
              <dt class="text-charcoal/60">Fecha deseada</dt>
              <dd class="text-charcoal">
                {new Date(order.desiredDate).toLocaleDateString("es-PE", { dateStyle: "long" })}
                {order.isUrgent && " · urgente"}
              </dd>
            </div>
            {
              order.customerNotes && (
                <div class="flex justify-between gap-4">
                  <dt class="shrink-0 text-charcoal/60">Tus notas</dt>
                  <dd class="text-right text-charcoal">{order.customerNotes}</dd>
                </div>
              )
            }
          </dl>

          {
            whatsappLink && (
              <a
                href={whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-block w-full rounded-full bg-emerald-600 px-8 py-3 text-center font-body text-sm font-semibold text-white transition-colors hover:bg-emerald-700 sm:w-auto"
              >
                Ver detalle en WhatsApp
              </a>
            )
          }

          {
            (canAcceptAdjustments || canCancel) && (
              <div class="mt-6 flex flex-wrap gap-3 border-t border-charcoal/10 pt-6">
                {canAcceptAdjustments && (
                  <button
                    type="button"
                    id="accept-adjustments"
                    class="rounded-full bg-pink-strong px-6 py-2.5 font-body text-sm font-semibold text-white transition-colors hover:bg-charcoal"
                  >
                    Aceptar ajustes
                  </button>
                )}
                {canCancel && (
                  <button
                    type="button"
                    id="cancel-order"
                    class="rounded-full border border-charcoal/20 px-6 py-2.5 font-body text-sm font-semibold text-charcoal transition-colors hover:bg-charcoal/5"
                  >
                    Cancelar pedido
                  </button>
                )}
              </div>
            )
          }

          <p id="order-action-error" class="mt-3 hidden text-sm text-red-600" />
        </div>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div
          class={`rounded-lg border bg-white p-4 sm:p-6 ${isPaymentStepActive ? "border-pink-strong ring-1 ring-pink-strong/30" : "border-charcoal/10"}`}
        >
          <p class="font-body text-sm font-semibold text-charcoal">Resumen</p>
          <div class="mt-3">
            <PaymentSummary
              subtotalCents={order.subtotalCents}
              urgencySurchargeCents={order.urgencySurchargeCents}
              deliveryCostCents={order.deliveryCostCents}
              deliveryMethod={order.deliveryMethod}
              totalCents={order.totalCents}
              initialPaymentCents={order.initialPaymentCents}
              finalPaymentCents={order.finalPaymentCents}
              finalPaymentCollected={order.finalPaymentCollected}
              showPayButton={order.status === "pago_inicial_pendiente"}
              publicId={order.publicId}
              status={order.status}
            />
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { fetchJson } from "../../../lib/http/fetchJson";

  const errorEl = document.getElementById("order-action-error");
  const publicId = window.location.pathname.split("/").pop();

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }

  async function postAction(path: string, button: HTMLButtonElement) {
    button.disabled = true;
    errorEl?.classList.add("hidden");
    try {
      await fetchJson(`/api/pedidos/${publicId}/${path}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: "{}",
      });
      window.location.reload();
    } catch (err) {
      showError(err instanceof Error ? err.message : "No se pudo completar la acción.");
      button.disabled = false;
    }
  }

  document.getElementById("toggle-change-delivery")?.addEventListener("click", () => {
    document.getElementById("delivery-form-wrapper")?.classList.toggle("hidden");
  });

  document.getElementById("accept-adjustments")?.addEventListener("click", (event) => {
    postAction("aceptar-ajustes", event.currentTarget as HTMLButtonElement);
  });

  document.getElementById("cancel-order")?.addEventListener("click", (event) => {
    if (!confirm("¿Seguro que quieres cancelar este pedido?")) return;
    postAction("cancelar", event.currentTarget as HTMLButtonElement);
  });

  // Actualización en vivo: sondea cada 15s si el estado cambió (ej. el admin
  // tomó el pedido en otra pestaña) — no recarga sola para no interrumpir a
  // alguien completando el formulario de entrega, solo avisa con una barra.
  const POLL_INTERVAL_MS = 15000;
  const statusContainer = document.querySelector<HTMLElement>("[data-order-status]");
  const initialStatus = statusContainer?.dataset.orderStatus;
  const updateBanner = document.getElementById("update-banner");

  document.getElementById("update-banner-refresh")?.addEventListener("click", () => {
    window.location.reload();
  });

  if (initialStatus) {
    const pollHandle = window.setInterval(async () => {
      try {
        const { order: latest } = await fetchJson<{ order: { status: string } }>(`/api/pedidos/${publicId}`);
        if (latest.status !== initialStatus) {
          updateBanner?.classList.remove("hidden");
          updateBanner?.classList.add("flex");
          window.clearInterval(pollHandle);
        }
      } catch {
        // Silencioso a propósito — un fallo puntual de red no debe molestar
        // al usuario, ya se reintenta en el próximo ciclo.
      }
    }, POLL_INTERVAL_MS);
  }
</script>
