---
import { eq, and, gte, lte, asc, desc } from "drizzle-orm";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/catalog/ProductCard.astro";
import { db } from "../../db/client";
import { categories, products } from "../../db/schema";
import { formatSoles } from "../../lib/orders/pricing";
import { siteConfig } from "../../config/site";

const { categoria } = Astro.params;

const category = await db.query.categories.findFirst({
  where: eq(categories.slug, categoria!),
});

if (!category) {
  return Astro.rewrite("/404");
}

// --- filtros (query params, sin JS: el <form> hace un GET normal) ---
const params = Astro.url.searchParams;
const urgentOnly = params.get("urgente") === "1";
const minPriceParam = params.get("precioMin");
const maxPriceParam = params.get("precioMax");
const sort = params.get("orden") ?? "destacados";

// Rango real de precios de la categoría (sin filtrar), para mostrar como
// referencia en el sidebar.
const allActiveProducts = await db.query.products.findMany({
  where: and(eq(products.categoryId, category.id), eq(products.active, true)),
  columns: { basePriceCents: true },
});
const priceBounds =
  allActiveProducts.length > 0
    ? {
        min: Math.min(...allActiveProducts.map((p) => p.basePriceCents)),
        max: Math.max(...allActiveProducts.map((p) => p.basePriceCents)),
      }
    : { min: 0, max: 0 };

const conditions = [eq(products.categoryId, category.id), eq(products.active, true)];
if (urgentOnly) conditions.push(eq(products.allowsUrgent, true));
if (minPriceParam) conditions.push(gte(products.basePriceCents, Math.round(Number(minPriceParam) * 100)));
if (maxPriceParam) conditions.push(lte(products.basePriceCents, Math.round(Number(maxPriceParam) * 100)));

function getOrderBy(sortKey: string) {
  switch (sortKey) {
    case "precio-asc":
      return [asc(products.basePriceCents)];
    case "precio-desc":
      return [desc(products.basePriceCents)];
    case "recientes":
      return [desc(products.createdAt)];
    default:
      return [desc(products.featured), asc(products.name)];
  }
}
const orderBy = getOrderBy(sort);

const categoryProducts = await db.query.products.findMany({
  where: and(...conditions),
  orderBy,
  with: { variants: true },
});

const items = categoryProducts.map((product) => ({
  name: product.name,
  priceLabel: formatSoles(product.basePriceCents),
  image: product.imageUrl,
  href: `/producto/${product.slug}`,
  hasVariants: product.variants.length > 0,
}));

const hasActiveFilters = urgentOnly || Boolean(minPriceParam) || Boolean(maxPriceParam) || sort !== "destacados";
---

<BaseLayout
  title={`${category.name} — ${siteConfig.name}`}
  description={`Catálogo de ${category.name.toLowerCase()} artesanales hechas a pedido.`}
>
  <nav class="mx-auto max-w-7xl px-4 pt-8 text-sm text-charcoal/60 md:px-6">
    <a href="/" class="hover:text-pink-strong">Inicio</a>
    <span class="mx-2">/</span>
    <span class="text-charcoal">{category.name}</span>
  </nav>

  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6">
    <h1 class="font-display text-3xl font-semibold text-charcoal">{category.name}</h1>

    <div class="mt-8 grid grid-cols-1 gap-10 md:grid-cols-[240px_1fr]">
      <!-- Sidebar de filtros: sticky para que no quede "flotando" en una
           columna corta mientras el grid de al lado sigue mucho más abajo. -->
      <aside class="md:sticky md:top-24 md:self-start">
        <form method="get" class="space-y-6 rounded-xl border border-charcoal/10 bg-white p-5">
          <div>
            <p class="font-body text-sm font-semibold text-charcoal">Disponibilidad</p>
            <label class="mt-2 flex items-center gap-2 font-body text-sm text-charcoal/70">
              <input
                type="checkbox"
                name="urgente"
                value="1"
                checked={urgentOnly}
                class="h-4 w-4 rounded border-charcoal/30 text-pink-strong focus:ring-pink-strong"
              />
              Disponible para pedido urgente
            </label>
          </div>

          <div>
            <p class="font-body text-sm font-semibold text-charcoal">Precio (S/)</p>
            <div class="mt-2 flex items-center gap-2">
              <input
                type="number"
                name="precioMin"
                min="0"
                step="1"
                placeholder={String(Math.floor(priceBounds.min / 100))}
                value={minPriceParam ?? ""}
                class="w-full rounded-md border border-charcoal/20 px-2 py-1.5 text-sm"
              />
              <span class="text-charcoal/40">–</span>
              <input
                type="number"
                name="precioMax"
                min="0"
                step="1"
                placeholder={String(Math.ceil(priceBounds.max / 100))}
                value={maxPriceParam ?? ""}
                class="w-full rounded-md border border-charcoal/20 px-2 py-1.5 text-sm"
              />
            </div>
            <p class="mt-1 font-body text-xs text-charcoal/50">
              Entre S/ {(priceBounds.min / 100).toFixed(0)} y S/ {(priceBounds.max / 100).toFixed(0)}
            </p>
          </div>

          <div>
            <p class="font-body text-sm font-semibold text-charcoal">Ordenar por</p>
            <select name="orden" class="mt-2 w-full rounded-md border border-charcoal/20 px-2 py-1.5 text-sm">
              <option value="destacados" selected={sort === "destacados"}>
                Destacados
              </option>
              <option value="precio-asc" selected={sort === "precio-asc"}>
                Precio: menor a mayor
              </option>
              <option value="precio-desc" selected={sort === "precio-desc"}>
                Precio: mayor a menor
              </option>
              <option value="recientes" selected={sort === "recientes"}>
                Más recientes
              </option>
            </select>
          </div>

          <button
            type="submit"
            class="w-full rounded-full bg-pink-strong px-4 py-2.5 font-body text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-charcoal hover:shadow-md"
          >
            Aplicar filtros
          </button>
          {
            hasActiveFilters && (
              <a
                href={`/catalogo/${category.slug}`}
                class="block text-center font-body text-xs font-medium text-charcoal/50 hover:text-pink-strong"
              >
                Limpiar filtros
              </a>
            )
          }
        </form>
      </aside>

      <!-- Grid de resultados -->
      <div>
        <p class="mb-6 font-body text-sm text-charcoal/60">
          {items.length} producto{items.length === 1 ? "" : "s"}
        </p>
        {
          items.length > 0 ? (
            <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-3">
              {items.map((item) => (
                <ProductCard {...item} />
              ))}
            </div>
          ) : (
            <div class="rounded-xl border border-charcoal/10 bg-white px-6 py-16 text-center">
              <p class="text-charcoal/60">Ningún producto coincide con estos filtros.</p>
              <a href={`/catalogo/${category.slug}`} class="mt-3 inline-block text-sm font-medium text-pink-strong hover:underline">
                Quitar filtros
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
