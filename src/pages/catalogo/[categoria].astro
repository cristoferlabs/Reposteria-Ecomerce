---
import { eq, and, asc, desc } from "drizzle-orm";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CatalogScroll from "../../components/catalog/CatalogScroll.astro";
import { db } from "../../db/client";
import { categories, products } from "../../db/schema";
import { attachVariants } from "../../db/queries";
import { formatSoles } from "../../lib/orders/pricing";
import {
  siteConfig,
  categoryShowcase,
  categoryShowcaseFallback,
  catalogProductImages,
  productCopy,
  productMaterials,
  productMaterialsFallback,
} from "../../config/site";

const { categoria } = Astro.params;

const [category] = await db.select().from(categories).where(eq(categories.slug, categoria!)).limit(1);

if (!category) {
  return Astro.rewrite("/404");
}

const showcase = categoryShowcase[category.slug] ?? categoryShowcaseFallback;

const categoryProducts = await attachVariants(
  await db
    .select()
    .from(products)
    .where(and(eq(products.categoryId, category.id), eq(products.active, true)))
    .orderBy(desc(products.featured), asc(products.name)),
);

const items = categoryProducts.map((product) => {
  const catalogImage = catalogProductImages[product.slug];
  const copy = productCopy[product.slug];
  const variants = product.variants
    .filter((v) => v.active)
    .sort((a, b) => a.sortOrder - b.sortOrder)
    .map((v) => ({ id: v.id, name: v.name, priceDeltaCents: v.priceDeltaCents }));
  return {
    productId: product.id,
    slug: product.slug,
    name: product.name,
    priceLabel: formatSoles(product.basePriceCents),
    basePriceCents: product.basePriceCents,
    image: catalogImage ?? product.imageUrl,
    href: `/producto/${product.slug}`,
    description: copy?.description ?? product.description,
    includes: copy?.includes ?? [],
    materials: productMaterials[product.slug] ?? productMaterialsFallback,
    variants,
    leadTimeDays: product.leadTimeDays,
    allowsUrgent: product.allowsUrgent,
    hasVariants: variants.length > 0,
  };
});
---

<BaseLayout
  title={`${category.name} — ${siteConfig.name}`}
  description={`Catálogo de ${category.name.toLowerCase()} artesanales hechas a pedido.`}
>
  <CatalogScroll
    items={items}
    accent={showcase.accent}
    categoryName={category.name}
    tagline={showcase.tagline}
  />
</BaseLayout>
