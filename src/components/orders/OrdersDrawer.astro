---
// Panel deslizable con el historial de pedidos del cliente — mismo patrón
// visual de overlay+panel que CartDrawer.astro (montado una sola vez en
// BaseLayout, se abre disparando "open-orders" en document). A diferencia
// del carrito, acá los pedidos se piden por fetch del lado del cliente recién
// al abrirse — no en cada carga de página vía BaseLayout — para no pagarle
// un round-trip a GET /api/pedidos a cada página, a todo usuario logueado,
// solo para un dato que la mayoría de las veces no se llega a ver.
---

<div
  id="orders-drawer-overlay"
  class="invisible fixed inset-0 z-60 bg-charcoal/50 opacity-0 transition-opacity duration-200"
>
  <aside
    id="orders-drawer-panel"
    class="ml-auto flex h-full w-full max-w-md translate-x-full flex-col bg-white shadow-2xl transition-transform duration-200"
  >
    <div class="flex items-center justify-between border-b border-charcoal/10 px-5 py-4">
      <h2 class="font-display text-lg font-semibold text-charcoal">Mis pedidos</h2>
      <button
        type="button"
        id="orders-drawer-close"
        aria-label="Cerrar"
        class="rounded-full p-1 text-charcoal/50 transition-colors hover:bg-charcoal/5 hover:text-charcoal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div id="orders-drawer-content" class="flex-1 overflow-y-auto px-5 py-4">
      <p class="py-10 text-center text-sm text-charcoal/50">Cargando...</p>
    </div>
  </aside>
</div>

<script>
  import { fetchJson } from "../../lib/http/fetchJson";
  import { STATUS_LABELS, STATUS_TONES } from "../../lib/orders/orderStatusMeta";
  import { formatSoles } from "../../lib/orders/pricing";
  import type { OrderStatus } from "../../db/schema";

  interface OrderSummary {
    publicId: string;
    status: OrderStatus;
    createdAt: string;
    totalCents: number;
    items: Array<{ quantity: number; product: { name: string; imageUrl: string }; variant: { name: string } | null }>;
  }

  const TONE_CLASSES: Record<string, string> = {
    neutral: "bg-charcoal/10 text-charcoal",
    warning: "bg-amber-100 text-amber-800",
    success: "bg-emerald-100 text-emerald-800",
    danger: "bg-red-100 text-red-700",
  };

  const overlay = document.getElementById("orders-drawer-overlay");
  const panel = document.getElementById("orders-drawer-panel");
  const closeBtn = document.getElementById("orders-drawer-close");
  const content = document.getElementById("orders-drawer-content");

  let loaded = false;

  function openDrawer() {
    if (!overlay || !panel) return;
    overlay.classList.remove("invisible", "opacity-0");
    overlay.classList.add("opacity-100");
    panel.classList.remove("translate-x-full");
    panel.classList.add("translate-x-0");
    document.body.classList.add("overflow-hidden");
    if (!loaded) loadOrders();
  }

  function closeDrawer() {
    if (!overlay || !panel) return;
    overlay.classList.add("opacity-0");
    overlay.classList.remove("opacity-100");
    panel.classList.add("translate-x-full");
    panel.classList.remove("translate-x-0");
    document.body.classList.remove("overflow-hidden");
    window.setTimeout(() => overlay.classList.add("invisible"), 200);
  }

  function escapeHtml(value: string): string {
    const div = document.createElement("div");
    div.textContent = value;
    return div.innerHTML;
  }

  function renderOrders(orders: OrderSummary[]) {
    if (!content) return;
    if (orders.length === 0) {
      content.innerHTML = `
        <div class="flex flex-col items-center justify-center gap-4 py-16 text-center">
          <p class="text-sm text-charcoal/60">Todavía no hiciste ningún pedido.</p>
          <a href="/" class="rounded-full bg-pink-strong px-6 py-2.5 font-body text-sm font-semibold text-white transition-colors hover:bg-charcoal">Ver catálogo</a>
        </div>`;
      return;
    }

    content.innerHTML = orders
      .map((order) => {
        const thumbs = order.items
          .slice(0, 3)
          .map((item) => {
            const name = escapeHtml(item.product.name);
            return `<div class="h-12 w-12 shrink-0 overflow-hidden rounded-lg border-2 border-white bg-neutral-100" title="${name}"><img src="${item.product.imageUrl}" alt="${name}" class="h-full w-full object-cover" /></div>`;
          })
          .join("");
        const tone = TONE_CLASSES[STATUS_TONES[order.status]] ?? TONE_CLASSES.neutral;
        const date = new Date(order.createdAt).toLocaleDateString("es-PE", { dateStyle: "medium" });
        return `
          <a href="/pedido/estado/${order.publicId}" class="block rounded-xl border border-charcoal/10 p-4 transition-colors hover:border-pink-strong/30">
            <div class="flex items-center justify-between gap-2">
              <p class="text-xs text-charcoal/60">#${order.publicId} · ${date}</p>
              <span class="inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${tone}">${STATUS_LABELS[order.status]}</span>
            </div>
            <div class="mt-3 flex items-center justify-between gap-3">
              <div class="flex -space-x-2">${thumbs}</div>
              <p class="font-body text-sm font-semibold text-charcoal">${formatSoles(order.totalCents)}</p>
            </div>
          </a>`;
      })
      .join('<div class="h-3"></div>');
  }

  async function loadOrders() {
    if (!content) return;
    try {
      const { orders } = await fetchJson<{ orders: OrderSummary[] }>("/api/pedidos");
      loaded = true;
      renderOrders(orders);
    } catch (err) {
      content.innerHTML = `<p class="py-10 text-center text-sm text-red-600">${
        err instanceof Error ? escapeHtml(err.message) : "No se pudieron cargar tus pedidos."
      }</p>`;
    }
  }

  document.addEventListener("open-orders", openDrawer);
  closeBtn?.addEventListener("click", closeDrawer);
  overlay?.addEventListener("click", (event) => {
    if (event.target === overlay) closeDrawer();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeDrawer();
  });

  // Lo pide /cuenta/mis-pedidos tras redirigir a "/" — esa ruta ya no
  // renderiza su propia página, solo marca este flag y vuelve acá.
  const REOPEN_KEY = "orders-drawer-open";
  if (sessionStorage.getItem(REOPEN_KEY)) {
    sessionStorage.removeItem(REOPEN_KEY);
    openDrawer();
  }
</script>
