---
interface Props {
  name: string;
  priceLabel: string;
  image: string;
  href: string;
  hasVariants?: boolean;
}

const { name, priceLabel, image, href, hasVariants = false } = Astro.props;
---

<a href={href} class="group block">
  <div class="relative aspect-[4/5] w-full overflow-hidden rounded-lg bg-neutral-100">
    <img
      src={image}
      alt={name}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <button
      type="button"
      class="quick-view-trigger absolute inset-x-3 bottom-3 translate-y-3 rounded-full bg-white/95 px-4 py-2.5 text-center font-body text-xs font-semibold text-charcoal opacity-0 shadow-md transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100 hover:bg-pink-strong hover:text-white"
      data-quickview-name={name}
      data-quickview-price={priceLabel}
      data-quickview-image={image}
      data-quickview-href={href}
    >
      {hasVariants ? "Seleccionar opciones" : "Vista rápida"}
    </button>
  </div>
  <h3 class="mt-3 font-body text-sm font-medium text-charcoal">{name}</h3>
  <p class="mt-1 font-body text-sm font-semibold text-pink-strong">{priceLabel}</p>
</a>

<script>
  document.querySelectorAll<HTMLButtonElement>(".quick-view-trigger").forEach((button) => {
    if (button.dataset.quickviewBound) return;
    button.dataset.quickviewBound = "true";

    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      document.dispatchEvent(
        new CustomEvent("open-quick-view", {
          detail: {
            name: button.dataset.quickviewName ?? "",
            price: button.dataset.quickviewPrice ?? "",
            image: button.dataset.quickviewImage ?? "",
            href: button.dataset.quickviewHref ?? "#",
          },
        }),
      );
    });
  });
</script>
