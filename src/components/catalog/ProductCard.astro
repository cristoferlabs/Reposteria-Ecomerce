---
interface Variant {
  id: number;
  name: string;
  priceDeltaCents: number;
}

interface Props {
  productId: number;
  name: string;
  priceLabel: string;
  basePriceCents: number;
  image: string;
  href: string;
  description?: string | null;
  variants?: Variant[];
  leadTimeDays?: number;
  allowsUrgent?: boolean;
  hasVariants?: boolean;
}

const {
  productId,
  name,
  priceLabel,
  basePriceCents,
  image,
  href,
  description = null,
  variants = [],
  leadTimeDays = 2,
  allowsUrgent = false,
  hasVariants = variants.length > 0,
} = Astro.props;

// Todo lo que necesita el quick-view enriquecido viaja en un solo JSON en
// vez de seguir sumando data-* sueltos — más simple de mantener a medida
// que crece la info que puede mostrar el modal.
const quickViewPayload = JSON.stringify({
  productId,
  name,
  priceLabel,
  basePriceCents,
  image,
  href,
  description,
  variants,
  leadTimeDays,
  allowsUrgent,
});
---

<a href={href} class="group block">
  <div class="relative aspect-[4/5] w-full overflow-hidden rounded-lg bg-neutral-100">
    <img
      src={image}
      alt={name}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <button
      type="button"
      class="quick-view-trigger absolute inset-x-3 bottom-3 translate-y-3 rounded-full bg-white/95 px-4 py-2.5 text-center font-body text-xs font-semibold text-charcoal opacity-0 shadow-md transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100 hover:bg-pink-strong hover:text-white"
      data-quickview-payload={quickViewPayload}
    >
      {hasVariants ? "Seleccionar opciones" : "Vista rápida"}
    </button>
  </div>
  <h3 class="mt-3 font-body text-sm font-medium text-charcoal">{name}</h3>
  <p class="mt-1 font-body text-sm font-semibold text-pink-strong">{priceLabel}</p>
</a>

<script>
  document.querySelectorAll<HTMLButtonElement>(".quick-view-trigger").forEach((button) => {
    if (button.dataset.quickviewBound) return;
    button.dataset.quickviewBound = "true";

    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (!button.dataset.quickviewPayload) return;
      const detail = JSON.parse(button.dataset.quickviewPayload);
      document.dispatchEvent(new CustomEvent("open-quick-view", { detail }));
    });
  });
</script>
