---
import { siteConfig, mainNav, studioProductImages } from "../../config/site";
import { loadCategoriesWithActiveProducts } from "../../db/queries";
import { getSessionUser } from "../../lib/auth";
import TiendaPanel from "./TiendaPanel.astro";

interface Props {
  cartCount?: number;
  transparent?: boolean;
}

const { cartCount = 0, transparent = false } = Astro.props;

const realCategoriesRaw = await loadCategoriesWithActiveProducts();
const realCategories = realCategoriesRaw
  .filter((cat) => cat.products.length > 0)
  .map((cat) => {
    const featured = cat.products[0];
    return {
      slug: cat.slug,
      name: cat.name,
      count: cat.products.length,
      image: studioProductImages[featured.slug] ?? featured.imageUrl,
    };
  });

const catalogHref = realCategories[0] ? `/catalogo/${realCategories[0].slug}` : "/catalogo/tortas";
const acercaDe = mainNav.find((item) => item.label === "Acerca de");
const menuLinks = mainNav.filter((item) => item.label !== "Acerca de");

const session = getSessionUser(Astro.request);
const shortTagline = siteConfig.tagline.split(" ").slice(0, 2).join(" ");

const fg = "text-charcoal";
const fgMuted = "text-charcoal/70";
const border = "border-charcoal/15";
const hoverBg = "hover:bg-charcoal/5";
const navLink =
  "font-body text-sm font-medium tracking-[0.14em] uppercase whitespace-nowrap text-charcoal transition-colors hover:text-pink-strong";
---

<header
  id="navbar-header"
  data-scrolled="false"
  data-transparent={transparent ? "true" : "false"}
  class:list={[
    "navbar z-50 w-full border-b border-transparent bg-transparent transition-[background-color,border-color,box-shadow,backdrop-filter] duration-300",
    "data-[scrolled=true]:border-charcoal/10 data-[scrolled=true]:bg-[#f7f5f2]/95 data-[scrolled=true]:shadow-[0_8px_24px_rgba(44,38,35,0.06)] data-[scrolled=true]:backdrop-blur-md",
    transparent ? "fixed inset-x-0 top-0" : "sticky top-0 shrink-0",
  ]}
>
  <div class="relative mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3.5 md:px-8 md:py-5">
    <!-- Izquierda: menú (+ logo en desktop) -->
    <div class="z-10 flex min-w-0 items-center gap-3">
      <button
        type="button"
        id="nav-open-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        class={`navbar-icon-btn flex h-11 w-11 shrink-0 items-center justify-center rounded-full border transition-colors sm:h-12 sm:w-12 ${border} ${fg} ${hoverBg}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
          <path d="M5 9h14M5 15h14" stroke-linecap="round" />
        </svg>
      </button>

      <a href="/" class={`hidden min-w-0 items-baseline gap-3 sm:flex ${fg}`}>
        <span class="font-display text-2xl font-semibold tracking-wide sm:text-3xl">{siteConfig.name.toUpperCase()}</span>
        <span class="hidden h-5 w-px bg-charcoal/20 lg:block" aria-hidden="true" />
        <span class={`hidden font-body text-xs font-medium tracking-[0.16em] uppercase lg:inline ${fgMuted}`}>
          {shortTagline}
        </span>
      </a>
    </div>

    <!-- Logo centrado solo en móvil (estilo Helias) -->
    <a
      href="/"
      class={`absolute left-1/2 top-1/2 z-[1] -translate-x-1/2 -translate-y-1/2 sm:hidden ${fg}`}
    >
      <span class="font-display text-xl font-semibold tracking-wide">{siteConfig.name.toUpperCase()}</span>
    </a>

    <div class="z-10 flex items-center gap-3 sm:gap-6 md:gap-8">
      <ul class={`hidden items-center gap-6 md:flex md:gap-8 ${fg}`}>
        <li>
          <button type="button" id="nav-tienda-toggle" class={`${navLink} inline-flex items-center gap-1.5`}>
            Tienda
            <span data-tienda-mark class="text-charcoal/40" aria-hidden="true">+</span>
          </button>
        </li>
        {
          acercaDe && (
            <li>
              <a href={acercaDe.href} class={navLink}>
                {acercaDe.label}
              </a>
            </li>
          )
        }
      </ul>

      <div class={`flex items-center gap-0.5 sm:gap-1.5 sm:border-l sm:border-charcoal/10 sm:pl-5 md:pl-6 ${fg}`}>
        {
          session ? (
            <a href="/api/auth/logout" aria-label="Cerrar sesión" class={`hidden p-2 transition-colors sm:inline-flex ${hoverBg}`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
                <path d="M15 17v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v1" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M9 12h11m0 0-3-3m3 3-3 3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          ) : (
            <a href="/cuenta/acceso" aria-label="Iniciar sesión" class={`hidden p-2 transition-colors sm:inline-flex ${hoverBg}`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
                <circle cx="12" cy="8" r="3.5" />
                <path d="M5 20c1.2-3.6 4-5.5 7-5.5s5.8 1.9 7 5.5" stroke-linecap="round" />
              </svg>
            </a>
          )
        }

        <button type="button" id="search-toggle" aria-label="Buscar" aria-expanded="false" class={`hidden p-2 transition-colors sm:inline-flex ${hoverBg}`}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
            <circle cx="11" cy="11" r="7" />
            <path d="m21 21-4.3-4.3" stroke-linecap="round" />
          </svg>
        </button>

        <button type="button" id="cart-toggle" aria-label="Ver mi pedido" class={`relative p-2 transition-colors ${hoverBg}`}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6">
            <path d="M6 8h12l-1 12H7L6 8Z" stroke-linejoin="round" />
            <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke-linecap="round" />
          </svg>
          {
            cartCount > 0 && (
              <span class="absolute top-0 right-0 flex h-5 w-5 items-center justify-center rounded-full bg-pink-strong text-[11px] font-semibold text-white">
                {cartCount}
              </span>
            )
          }
        </button>
      </div>
    </div>
  </div>

  <div id="search-panel" class="hidden border-t border-charcoal/10 bg-white px-4 py-3 md:px-6">
    <form action="/buscar" method="get" class="mx-auto flex max-w-2xl items-center gap-2 border border-charcoal/20 bg-white px-4 py-2">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0 text-charcoal/50">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        name="q"
        placeholder="Buscar productos..."
        class="w-full bg-transparent text-sm text-charcoal outline-none placeholder:text-charcoal/40"
      />
    </form>
  </div>
</header>

<!-- Menú completo: Tienda, Catálogo, Acerca de, Datos, Admin, Mis pedidos -->
<div id="nav-fullscreen" class="fixed inset-0 z-[60] hidden flex-col bg-cream" role="dialog" aria-modal="true" aria-label="Menú">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-4 md:px-6">
    <button
      type="button"
      id="nav-close-toggle"
      aria-label="Cerrar menú"
      class="flex h-12 w-12 items-center justify-center rounded-full border border-charcoal/15 bg-white text-charcoal transition-colors hover:bg-charcoal hover:text-white"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
    <span class="font-display text-2xl font-semibold tracking-wide text-charcoal">{siteConfig.name.toUpperCase()}</span>
    <div class="h-12 w-12" aria-hidden="true" />
  </div>

  <nav class="flex flex-1 flex-col justify-center gap-2 overflow-y-auto px-6 py-6 sm:px-12">
    <button
      type="button"
      id="nav-fullscreen-tienda"
      class="py-2 text-left font-display text-5xl font-semibold tracking-tight text-charcoal transition-colors hover:text-pink-strong sm:text-6xl"
    >
      Tienda
    </button>
    <a
      href={catalogHref}
      class="py-2 font-display text-5xl font-semibold tracking-tight text-charcoal transition-colors hover:text-pink-strong sm:text-6xl"
    >
      Catálogo
    </a>
    {
      acercaDe && (
        <a
          href={acercaDe.href}
          class="py-2 font-display text-5xl font-semibold tracking-tight text-charcoal transition-colors hover:text-pink-strong sm:text-6xl"
        >
          {acercaDe.label}
        </a>
      )
    }
    {
      menuLinks
        .filter((item) => item.label !== "Catálogo")
        .map((item) => (
          <a
            href={item.href}
            class="py-2 font-display text-5xl font-semibold tracking-tight text-charcoal transition-colors hover:text-pink-strong sm:text-6xl"
          >
            {item.label}
          </a>
        ))
    }
    {
      session?.role === "admin" && (
        <a
          href="/admin/solicitudes"
          class="py-2 font-display text-5xl font-semibold tracking-tight text-charcoal transition-colors hover:text-pink-strong sm:text-6xl"
        >
          Admin
        </a>
      )
    }
  </nav>

  <div class="border-t border-charcoal/10 px-6 py-6 sm:px-12">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 font-body text-sm font-medium text-charcoal">
      {
        session ? (
          <button type="button" id="nav-fullscreen-orders" class="tracking-wide uppercase hover:text-pink-strong">
            Mis pedidos
          </button>
        ) : (
          <a href="/cuenta/acceso" class="tracking-wide uppercase hover:text-pink-strong">
            Iniciar sesión
          </a>
        )
      }
    </div>
  </div>
</div>

<TiendaPanel />

<script>
  function setupToggle(buttonId: string, panelId: string) {
    const button = document.getElementById(buttonId);
    const panel = document.getElementById(panelId);
    if (!button || !panel) return;
    button.addEventListener("click", () => {
      const isOpen = panel.classList.toggle("hidden") === false;
      button.setAttribute("aria-expanded", String(isOpen));
    });
  }

  setupToggle("search-toggle", "search-panel");

  document.getElementById("cart-toggle")?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("open-cart"));
  });

  function openOrders() {
    document.dispatchEvent(new CustomEvent("open-orders"));
  }
  document.getElementById("nav-fullscreen-orders")?.addEventListener("click", openOrders);

  const tiendaMark = document.querySelector<HTMLElement>("[data-tienda-mark]");

  function openTienda() {
    document.dispatchEvent(new CustomEvent("open-tienda"));
    if (tiendaMark) tiendaMark.textContent = "−";
  }

  document.getElementById("nav-tienda-toggle")?.addEventListener("click", openTienda);

  document.addEventListener("tienda-closed", () => {
    if (tiendaMark) tiendaMark.textContent = "+";
  });

  const fullscreenPanel = document.getElementById("nav-fullscreen");
  const openBtn = document.getElementById("nav-open-toggle");
  const closeBtn = document.getElementById("nav-close-toggle");

  function openFullscreen() {
    if (!fullscreenPanel) return;
    fullscreenPanel.classList.remove("hidden");
    fullscreenPanel.classList.add("flex");
    document.body.style.overflow = "hidden";
    openBtn?.setAttribute("aria-expanded", "true");
  }

  function closeFullscreen() {
    if (!fullscreenPanel) return;
    fullscreenPanel.classList.add("hidden");
    fullscreenPanel.classList.remove("flex");
    document.body.style.overflow = "";
    openBtn?.setAttribute("aria-expanded", "false");
  }

  openBtn?.addEventListener("click", openFullscreen);
  closeBtn?.addEventListener("click", closeFullscreen);

  document.getElementById("nav-fullscreen-tienda")?.addEventListener("click", () => {
    closeFullscreen();
    openTienda();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (fullscreenPanel && !fullscreenPanel.classList.contains("hidden")) closeFullscreen();
  });

  const navHeader = document.getElementById("navbar-header");
  if (navHeader) {
    // En home (nav fija / sin scroll de página) permanece siempre transparente
    const stayTransparent = navHeader.dataset.transparent === "true";
    const threshold = 24;
    function updateScrolled() {
      if (stayTransparent) {
        navHeader!.dataset.scrolled = "false";
        return;
      }
      navHeader!.dataset.scrolled = window.scrollY > threshold ? "true" : "false";
    }
    updateScrolled();
    window.addEventListener("scroll", updateScrolled, { passive: true });
  }
</script>

<style>
  #navbar-header[data-scrolled="false"] .navbar-icon-btn {
    background: rgba(255, 255, 255, 0.35);
    border-color: rgba(44, 38, 35, 0.16);
    backdrop-filter: blur(4px);
  }

  #navbar-header[data-transparent="true"][data-scrolled="false"] .navbar-icon-btn {
    background: rgba(255, 255, 255, 0.45);
  }

  #navbar-header[data-scrolled="true"] .navbar-icon-btn {
    background: rgba(255, 255, 255, 0.9);
  }
</style>
