---
// Panel Tienda: sube desde abajo, las 4 piezas caben completas + “Ver más” al catálogo.
import { tiendaBlocks, tiendaCatalogHref } from "../../config/site";
---

<div id="tienda-panel" class="fixed inset-0 z-[65] hidden" role="dialog" aria-modal="true" aria-label="Tienda">
  <div id="tienda-backdrop" class="absolute inset-0 bg-charcoal/25" />
  <div
    id="tienda-sheet"
    class="absolute inset-x-0 bottom-0 flex max-h-[78vh] flex-col border-t border-charcoal/10 bg-cream"
  >
    <div class="mx-auto flex w-full max-w-7xl shrink-0 items-center justify-between gap-4 px-4 pt-5 pb-3 md:px-8 md:pt-6">
      <p class="font-display text-2xl font-semibold tracking-wide text-charcoal sm:text-3xl">Tienda</p>
      <button
        type="button"
        id="tienda-close"
        aria-label="Cerrar tienda"
        class="flex h-11 w-11 shrink-0 items-center justify-center border border-charcoal/15 text-charcoal transition-colors hover:bg-charcoal hover:text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="mx-auto w-full max-w-7xl flex-1 overflow-y-auto px-4 pb-6 md:px-8 md:pb-8">
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-5">
        {
          tiendaBlocks.map((block) => (
            <a href={block.href} class="group flex min-w-0 flex-col">
              <div class="aspect-[4/3] w-full overflow-hidden bg-white sm:aspect-[5/4]">
                <img
                  src={block.image}
                  alt={block.name}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <p class="mt-3 font-display text-base font-semibold tracking-wide text-charcoal transition-colors group-hover:text-pink-strong sm:text-lg">
                {block.name}
              </p>
              <p class="mt-1 font-body text-sm leading-snug text-charcoal/70">{block.description}</p>
            </a>
          ))
        }
      </div>

      <div class="mt-6 flex justify-center border-t border-charcoal/10 pt-5 sm:mt-8 sm:pt-6">
        <a
          href={tiendaCatalogHref}
          class="inline-flex items-center gap-2 rounded-md bg-charcoal px-8 py-3.5 font-body text-sm font-semibold tracking-[0.12em] text-cream uppercase transition-colors hover:bg-pink-strong"
        >
          Ver más
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";

  const panel = document.getElementById("tienda-panel");
  const sheet = document.getElementById("tienda-sheet");
  const backdrop = document.getElementById("tienda-backdrop");
  const closeBtn = document.getElementById("tienda-close");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function openTienda() {
    if (!panel || !sheet || !backdrop) return;
    panel.classList.remove("hidden");
    document.body.style.overflow = "hidden";

    if (prefersReducedMotion) {
      gsap.set(sheet, { y: 0 });
      gsap.set(backdrop, { opacity: 1 });
      return;
    }

    gsap.fromTo(backdrop, { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power2.out" });
    gsap.fromTo(sheet, { y: "100%" }, { y: "0%", duration: 0.4, ease: "power3.out" });
  }

  function closeTienda() {
    if (!panel || !sheet || !backdrop) return;

    function hide() {
      panel!.classList.add("hidden");
      document.body.style.overflow = "";
      document.dispatchEvent(new CustomEvent("tienda-closed"));
    }

    if (prefersReducedMotion) {
      hide();
      return;
    }

    gsap.to(backdrop, { opacity: 0, duration: 0.2, ease: "power2.in" });
    gsap.to(sheet, { y: "100%", duration: 0.3, ease: "power2.in", onComplete: hide });
  }

  document.addEventListener("open-tienda", openTienda);
  closeBtn?.addEventListener("click", closeTienda);
  backdrop?.addEventListener("click", closeTienda);
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (panel && !panel.classList.contains("hidden")) closeTienda();
  });
</script>
