---
import { siteConfig, footerNav } from "../../config/site";

const year = new Date().getFullYear();
---

<footer class="w-full bg-charcoal text-cream">
  <div class="mx-auto max-w-7xl px-4 py-10 md:px-6">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="text-center sm:text-left">
        <p class="font-body text-lg font-semibold text-white">{siteConfig.name}</p>
        <p class="mt-1 text-sm text-cream/60">{siteConfig.tagline}</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-cream/70">
        <a href="/legal/sobre-nosotros" class="transition-colors hover:text-white">Acerca de</a>
        <a href="/legal/contacto" class="transition-colors hover:text-white">Datos sobre la empresa</a>
        {
          footerNav.info.slice(1).map((item) => (
            <a href={item.href} class="transition-colors hover:text-white">
              {item.label}
            </a>
          ))
        }
        <button type="button" id="open-tour-trigger" class="transition-colors hover:text-white">
          ¿Cómo funciona?
        </button>
      </div>
    </div>
    <p class="mt-8 text-center text-xs text-cream/40">
      © {year} {siteConfig.name}. Todos los derechos reservados.
    </p>
  </div>
</footer>

<script>
  document.getElementById("open-tour-trigger")?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("open-tour"));
  });
</script>
