---
import { siteConfig, footerNav } from "../../config/site";

const year = new Date().getFullYear();
const paymentMethods = ["Visa", "Mastercard", "Mercado Pago", "Yape", "Plin"];

const trustPoints = [
  {
    title: "Hecho con cuidado",
    text: "Ingredientes seleccionados y detalles que se notan en cada bocado.",
  },
  {
    title: "Fresco, nunca de stock",
    text: "Cada pedido se prepara desde cero para la fecha que elegiste.",
  },
  {
    title: "Para repetir siempre",
    text: "Sabores pensados para que vuelvas a pedir una y otra vez.",
  },
];
---

<section class="w-full bg-cream px-4 py-14 sm:py-16" data-reveal>
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 text-center sm:grid-cols-3" data-reveal-group>
    {
      trustPoints.map((point) => (
        <div data-reveal-item>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            class="mx-auto h-9 w-9 text-pink-strong"
          >
            <path
              d="M12 3l1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4L12 3Z"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <p class="mt-4 font-display text-lg font-semibold text-charcoal">{point.title}</p>
          <p class="mx-auto mt-2 max-w-xs font-body text-sm leading-relaxed text-charcoal/70">{point.text}</p>
        </div>
      ))
    }
  </div>
</section>

<footer class="w-full bg-charcoal text-cream" data-reveal>
  <div class="mx-auto max-w-7xl px-4 py-12 md:px-6">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Sobre nosotros -->
      <div>
        <img src={siteConfig.logoUrl} alt={siteConfig.name} class="h-16 w-16 object-contain" />
        <p class="mt-3 font-display text-xl font-semibold text-white">{siteConfig.name}</p>
        <p class="mt-3 text-sm leading-relaxed text-cream/70">{siteConfig.tagline}</p>
        <a href="/legal/sobre-nosotros" class="mt-3 inline-block text-sm font-medium text-pink-soft hover:text-white transition-colors">
          Conócenos
        </a>
      </div>

      <!-- Atención al cliente -->
      <div>
        <p class="font-body text-sm font-semibold uppercase tracking-wide text-white/80">
          Atención al cliente
        </p>
        <ul class="mt-4 flex flex-col gap-2 text-sm text-cream/70">
          {
            footerNav.atencionAlCliente.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <button type="button" id="open-tour-trigger" class="text-left transition-colors hover:text-white">
              ¿Cómo funciona?
            </button>
          </li>
        </ul>
      </div>

      <!-- Info -->
      <div>
        <p class="font-body text-sm font-semibold uppercase tracking-wide text-white/80">Info</p>
        <ul class="mt-4 flex flex-col gap-2 text-sm text-cream/70">
          {
            footerNav.info.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Selector de país -->
      <div>
        <p class="font-body text-sm font-semibold uppercase tracking-wide text-white/80">País</p>
        <label class="mt-4 block">
          <span class="sr-only">Seleccionar país</span>
          <select
            class="w-full rounded-md border border-white/20 bg-charcoal px-3 py-2 text-sm text-cream/80"
            disabled
          >
            <option>Perú (S/)</option>
          </select>
        </label>
      </div>
    </div>

    <!-- Redes sociales -->
    <div class="mt-10 flex items-center justify-center gap-5 border-t border-white/10 pt-8">
      <a href={siteConfig.social.instagram} aria-label="Instagram" class="text-cream/70 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a href={siteConfig.social.facebook} aria-label="Facebook" class="text-cream/70 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
          <path d="M14 9h3V6h-3a3 3 0 0 0-3 3v2H9v3h2v6h3v-6h2.5l.5-3H14V9Z" stroke-linejoin="round" />
        </svg>
      </a>
      <a href={siteConfig.social.tiktok} aria-label="TikTok" class="text-cream/70 hover:text-white transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
          <path d="M14 4v10.5a2.5 2.5 0 1 1-2.5-2.5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M14 4c.4 2 2 3.5 4 3.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <!-- Métodos de pago + copyright -->
    <div class="mt-8 flex flex-col items-center gap-4 border-t border-white/10 pt-8 text-center">
      <div class="flex flex-wrap items-center justify-center gap-2">
        {
          paymentMethods.map((method) => (
            <span class="rounded-md border border-white/15 px-2.5 py-1 text-xs font-medium text-cream/70">
              {method}
            </span>
          ))
        }
      </div>
      <p class="text-xs text-cream/50">
        © {year} {siteConfig.name}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<script>
  document.getElementById("open-tour-trigger")?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("open-tour"));
  });
</script>
