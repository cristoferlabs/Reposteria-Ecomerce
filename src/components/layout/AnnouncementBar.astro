---
import { siteConfig } from "../../config/site";

// Marquee de scroll continuo: se repite el bloque de mensajes dos veces y se
// anima trasladando exactamente -50% del ancho total — como el contenido es
// idéntico en ambas mitades, el loop queda perfecto sin importar el ancho
// real del texto. La segunda mitad se oculta a lectores de pantalla.
const MESSAGES = [siteConfig.announcement, "Hecho a pedido, con amor", "Recojo o delivery en Lima"];
const track = [...MESSAGES, ...MESSAGES];
---

<div class="w-full overflow-hidden bg-charcoal py-2">
  <div class="marquee-track flex w-max items-center whitespace-nowrap">
    {
      track.map((message, i) => (
        <span
          aria-hidden={i >= MESSAGES.length ? "true" : undefined}
          class="flex items-center px-6 font-body text-xs font-medium tracking-wide text-cream sm:text-sm"
        >
          {message}
          <span class="ml-6 text-gold" aria-hidden="true">
            ✦
          </span>
        </span>
      ))
    }
  </div>
</div>
