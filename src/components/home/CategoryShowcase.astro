---
// Hero estilo Helias: desktop = panel derecho ondulado; móvil = diagonal
// arriba-derecha (como heliasoils). Una sola viewport, puntos bajo el CTA.
import type { CategoryAccent } from "../../config/site";
import { categoryShowcase, categoryShowcaseFallback, studioProductImages } from "../../config/site";
import { loadCategoriesWithActiveProducts } from "../../db/queries";

const categoriesWithProducts = await loadCategoriesWithActiveProducts();

const slides = categoriesWithProducts
  .filter((cat) => cat.products.length > 0)
  .map((cat) => {
    const showcase = categoryShowcase[cat.slug] ?? categoryShowcaseFallback;
    const featuredProduct = cat.products[0];
    const studioImage = studioProductImages[featuredProduct.slug];
    return {
      slug: cat.slug,
      name: cat.name,
      tagline: showcase.tagline,
      accent: showcase.accent,
      image: studioImage ?? featuredProduct.imageUrl,
      isStudio: Boolean(studioImage),
      count: cat.products.length,
    };
  });

const PANEL_COLOR: Record<CategoryAccent, string> = {
  pink: "#e4a9bd",
  gold: "#d9c48a",
};

const CTA_CLASS: Record<CategoryAccent, string> = {
  pink: "bg-pink-strong text-white hover:bg-charcoal",
  gold: "bg-charcoal text-cream hover:bg-pink-strong",
};

const firstPanel = slides[0] ? PANEL_COLOR[slides[0].accent] : PANEL_COLOR.pink;

/** Home: diagonal orgánica desde esquina superior derecha (no media pantalla). */
const DESKTOP_A =
  "M0.55,0 L1,0 L1,0.68 C0.92,0.62 0.86,0.48 0.8,0.36 C0.74,0.24 0.7,0.14 0.64,0.08 C0.6,0.04 0.57,0.01 0.55,0 Z";
const DESKTOP_B =
  "M0.5,0 L1,0 L1,0.74 C0.94,0.66 0.88,0.52 0.82,0.4 C0.76,0.28 0.7,0.16 0.62,0.1 C0.56,0.05 0.52,0.02 0.5,0 Z";

/** Móvil: misma diagonal, compacta */
const MOBILE_A =
  "M0.32,0 L1,0 L1,0.52 C0.88,0.46 0.78,0.36 0.66,0.26 C0.54,0.16 0.42,0.08 0.32,0 Z";
const MOBILE_B =
  "M0.26,0 L1,0 L1,0.58 C0.9,0.5 0.78,0.4 0.64,0.28 C0.5,0.16 0.36,0.08 0.26,0 Z";
---

{
  slides.length > 0 && (
    <section
      class="showcase relative h-full w-full overflow-hidden bg-white"
      data-showcase
      data-desktop-a={DESKTOP_A}
      data-desktop-b={DESKTOP_B}
      data-mobile-a={MOBILE_A}
      data-mobile-b={MOBILE_B}
      style={`--panel-color: ${firstPanel}`}
    >
      <svg
        class="showcase-split pointer-events-none absolute inset-0 h-full w-full"
        viewBox="0 0 1 1"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <clipPath id="showcase-wave-clip" clipPathUnits="objectBoundingBox">
            <path data-showcase-wave d={DESKTOP_A} />
          </clipPath>
        </defs>
        <rect
          data-showcase-panel
          width="1"
          height="1"
          fill={firstPanel}
          clip-path="url(#showcase-wave-clip)"
        />
      </svg>

      <div class="relative z-10 flex h-full min-h-0 flex-col pt-[4.5rem] sm:pt-[5.25rem]">
        {slides.length > 1 && (
          <div class="showcase-counter-vertical absolute top-1/2 left-3 z-20 hidden -translate-y-1/2 lg:flex lg:left-5">
            <span data-counter-total>{String(slides.length).padStart(2, "0")}</span>
            <span class="showcase-counter-sep-v" aria-hidden="true" />
            <span data-counter-current>01</span>
          </div>
        )}

        <div class="relative mx-auto h-full w-full max-w-[1400px] min-h-0">
          {slides.map((slide, i) => (
            <div
              class="showcase-slide absolute inset-0 z-10"
              data-slide
              data-panel-color={PANEL_COLOR[slide.accent]}
              style={i === 0 ? undefined : "visibility:hidden;opacity:0;pointer-events:none;"}
            >
              <div class="flex h-full min-h-0 flex-col lg:grid lg:grid-cols-2 lg:items-center">
                <div class="showcase-media relative flex min-h-0 flex-[1.2] items-center justify-center px-6 pt-1 lg:order-2 lg:flex-none lg:h-full lg:px-8 lg:pt-0">
                  <img
                    src={slide.image}
                    alt={slide.name}
                    class:list={[
                      "showcase-photo relative z-[1] object-contain",
                      slide.isStudio
                        ? "h-[min(40vh,320px)] w-[82%] max-w-[380px] drop-shadow-[0_20px_40px_rgba(44,38,35,0.16)] lg:h-[min(74vh,680px)] lg:w-[94%] lg:max-w-[560px]"
                        : "h-[min(36vh,280px)] w-[76%] max-w-[320px] lg:h-[min(70vh,620px)] lg:w-[84%] lg:max-w-[500px]",
                    ]}
                    loading={i === 0 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : "low"}
                  />
                </div>

                <div class="showcase-slide-text flex flex-col items-center px-6 pb-5 text-center lg:order-1 lg:items-start lg:justify-center lg:px-14 lg:pb-12 lg:pl-16 lg:text-left xl:pl-20">
                  <p class="font-body text-[0.7rem] font-medium tracking-[0.2em] text-charcoal/45 uppercase sm:text-sm">
                    {slide.count} producto{slide.count === 1 ? "" : "s"}
                  </p>
                  <h2 class="showcase-title mt-2 font-hero text-[clamp(3.25rem,11vw,8.25rem)] leading-[0.88] font-semibold tracking-tight text-charcoal lg:mt-4">
                    {slide.name}
                  </h2>
                  <p class="showcase-tagline mt-4 max-w-md text-editorial text-[0.9rem] leading-relaxed text-charcoal/75 sm:text-base lg:mt-6 lg:text-lg">
                    {slide.tagline}
                  </p>
                  <a
                    href={`/catalogo/${slide.slug}`}
                    class={`showcase-cta mt-6 inline-flex w-fit px-9 py-4 font-body text-sm font-semibold tracking-[0.14em] uppercase transition-colors duration-200 lg:mt-9 ${CTA_CLASS[slide.accent]}`}
                  >
                    Ver catálogo
                  </a>

                  {slides.length > 1 && (
                    <div class="mt-6 flex min-h-[1.35rem] items-center justify-center gap-3 lg:justify-start" data-showcase-dots-slot />
                  )}
                </div>
              </div>
            </div>
          ))}

          {slides.length > 1 && (
            <>
              <div class="pointer-events-none absolute inset-y-0 left-0 right-0 z-20 hidden items-center justify-between px-2 lg:flex lg:px-4">
                <button
                  type="button"
                  class="showcase-arrow pointer-events-auto"
                  data-showcase-prev
                  aria-label="Categoría anterior"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                    <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <button
                  type="button"
                  class="showcase-arrow pointer-events-auto"
                  data-showcase-next
                  aria-label="Categoría siguiente"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                    <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </div>

              <!-- Puntos: se reubican bajo el CTA del slide activo via JS; markup canónico aquí -->
              <div class="showcase-dots-source absolute -left-[9999px]" aria-hidden="true">
                <div class="flex items-center gap-3" data-showcase-dots>
                  {slides.map((slide, i) => (
                    <button
                      type="button"
                      class:list={["showcase-dot", i === 0 && "is-active"]}
                      data-showcase-dot
                      aria-label={`Ir a ${slide.name}`}
                    >
                      <span class="showcase-dot__core" />
                      <svg class="showcase-dot__ring" viewBox="0 0 36 36" aria-hidden="true">
                        <circle
                          class="showcase-dot__ring-track"
                          cx="18"
                          cy="18"
                          r="15"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.25"
                        />
                        <circle
                          class="showcase-dot__ring-fill"
                          data-showcase-ring
                          cx="18"
                          cy="18"
                          r="15"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          pathLength="100"
                          stroke-dasharray="100"
                          stroke-dashoffset="100"
                        />
                      </svg>
                    </button>
                  ))}
                </div>
              </div>
            </>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .showcase-arrow {
    display: flex;
    height: 2.85rem;
    width: 2.85rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(46, 35, 32, 0.14);
    color: var(--color-charcoal);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(6px);
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
  }

  .showcase-arrow:hover {
    background: var(--color-charcoal);
    color: white;
    transform: scale(1.04);
  }

  .showcase-dot {
    position: relative;
    display: flex;
    height: 1.35rem;
    width: 1.35rem;
    align-items: center;
    justify-content: center;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--color-charcoal);
    cursor: pointer;
  }

  .showcase-dot__core {
    height: 0.38rem;
    width: 0.38rem;
    border-radius: 9999px;
    background: rgba(44, 38, 35, 0.28);
    transition:
      background-color 0.3s ease,
      transform 0.3s ease;
  }

  .showcase-dot.is-active .showcase-dot__core,
  .showcase-dot.is-complete .showcase-dot__core {
    background: var(--color-charcoal);
  }

  .showcase-dot__ring {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: rotate(-90deg);
    transition: opacity 0.25s ease;
  }

  .showcase-dot.is-active .showcase-dot__ring {
    opacity: 1;
  }

  .showcase-dot__ring-track {
    opacity: 0.2;
  }

  .showcase-counter-vertical {
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(44, 38, 35, 0.55);
  }

  .showcase-counter-sep-v {
    width: 1px;
    height: 48px;
    background: rgba(44, 38, 35, 0.28);
  }
</style>

<script>
  import gsap from "gsap";

  const AUTOPLAY_MS = 5500;
  const RING_LEN = 100;

  function initShowcase(root: HTMLElement) {
    if (root.dataset.showcaseInit === "true") return;
    root.dataset.showcaseInit = "true";

    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const panel = root.querySelector<SVGRectElement>("[data-showcase-panel]");
    const wave = root.querySelector<SVGPathElement>("[data-showcase-wave]");
    const desktopA = root.dataset.desktopA ?? "";
    const desktopB = root.dataset.desktopB ?? "";
    const mobileA = root.dataset.mobileA ?? "";
    const mobileB = root.dataset.mobileB ?? "";
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-showcase-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-showcase-next]");
    const dotsWrap = root.querySelector<HTMLElement>("[data-showcase-dots]");
    const counterCurrent = root.querySelector<HTMLElement>("[data-counter-current]");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const desktopMq = window.matchMedia("(min-width: 1024px)");

    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-showcase-dot]"));
    const rings = Array.from(root.querySelectorAll<SVGCircleElement>("[data-showcase-ring]"));

    let current = 0;
    let autoplayTimer: number | undefined;
    let ringTween: gsap.core.Tween | null = null;
    let waveTween: gsap.core.Tween | null = null;
    let animating = false;

    function placeDotsOnActiveSlide() {
      if (!dotsWrap) return;
      const active = slides[current];
      const target = active?.querySelector<HTMLElement>("[data-showcase-dots-slot]");
      if (target) target.appendChild(dotsWrap);
    }

    placeDotsOnActiveSlide();

    function wavePair() {
      return desktopMq.matches
        ? { a: desktopA, b: desktopB }
        : { a: mobileA, b: mobileB };
    }

    function startWaveLoop() {
      if (!wave || prefersReducedMotion) return;
      waveTween?.kill();
      const { a, b } = wavePair();
      if (!a || !b) return;
      gsap.set(wave, { attr: { d: a } });
      waveTween = gsap.to(wave, {
        attr: { d: b },
        duration: 5.5,
        ease: "sine.inOut",
        yoyo: true,
        repeat: -1,
      });
    }

    // Arranca ya con la forma correcta (desktop vs móvil)
    const initial = wavePair();
    if (wave && initial.a) wave.setAttribute("d", initial.a);
    startWaveLoop();
    desktopMq.addEventListener("change", startWaveLoop);

    function floatPhoto(slideEl: HTMLElement, enable: boolean) {
      const photo = slideEl.querySelector<HTMLElement>(".showcase-photo");
      if (!photo || prefersReducedMotion) return;
      gsap.killTweensOf(photo);
      if (enable) {
        gsap.to(photo, {
          y: -10,
          duration: 3.4,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
        });
      }
    }

    floatPhoto(slides[0], true);

    function setPanelColor(color: string, animate: boolean) {
      root.style.setProperty("--panel-color", color);
      if (!panel) return;
      if (animate && !prefersReducedMotion) {
        gsap.to(panel, { attr: { fill: color }, duration: 0.9, ease: "power2.inOut" });
      } else {
        panel.setAttribute("fill", color);
      }
    }

    function syncDots(activeIndex: number) {
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === activeIndex);
        dot.classList.toggle("is-complete", i < activeIndex);
      });
      rings.forEach((ring, i) => {
        gsap.set(ring, { strokeDashoffset: i < activeIndex ? 0 : RING_LEN });
      });
    }

    function stopRing() {
      ringTween?.kill();
      ringTween = null;
    }

    function startRing() {
      stopRing();
      if (prefersReducedMotion) return;
      syncDots(current);
      const ring = rings[current];
      if (!ring) return;
      gsap.set(ring, { strokeDashoffset: RING_LEN });
      ringTween = gsap.to(ring, {
        strokeDashoffset: 0,
        duration: AUTOPLAY_MS / 1000,
        ease: "none",
      });
    }

    function updateCounter(index: number) {
      if (counterCurrent) counterCurrent.textContent = String(index + 1).padStart(2, "0");
    }

    function goTo(target: number) {
      const next = ((target % slides.length) + slides.length) % slides.length;
      if (next === current || animating) return;

      const outgoing = slides[current];
      const incoming = slides[next];
      const outText = outgoing.querySelector<HTMLElement>(".showcase-slide-text");
      const inText = incoming.querySelector<HTMLElement>(".showcase-slide-text");
      const outMedia = outgoing.querySelector<HTMLElement>(".showcase-media");
      const inMedia = incoming.querySelector<HTMLElement>(".showcase-media");
      const outBits = outText
        ? Array.from(outText.querySelectorAll<HTMLElement>("p, h2, a")).filter(
            (el) => !el.closest("[data-showcase-dots]"),
          )
        : [];
      const inBits = inText
        ? Array.from(inText.querySelectorAll<HTMLElement>("p, h2, a")).filter(
            (el) => !el.closest("[data-showcase-dots]"),
          )
        : [];

      gsap.killTweensOf([
        outgoing,
        incoming,
        outText,
        inText,
        outMedia,
        inMedia,
        ...outBits,
        ...inBits,
      ]);
      animating = true;

      const nextColor = incoming.dataset.panelColor ?? "";
      if (nextColor) setPanelColor(nextColor, true);

      floatPhoto(outgoing, false);
      floatPhoto(incoming, false);

      if (prefersReducedMotion) {
        gsap.set(outgoing, { autoAlpha: 0, pointerEvents: "none" });
        gsap.set(incoming, { autoAlpha: 1, pointerEvents: "auto" });
        animating = false;
        floatPhoto(incoming, true);
      } else {
        const tl = gsap.timeline({
          onComplete: () => {
            animating = false;
            floatPhoto(incoming, true);
          },
        });

        tl.to(outBits, { y: -18, autoAlpha: 0, duration: 0.4, stagger: 0.03, ease: "power2.in" }, 0);
        tl.to(outMedia, { y: 16, scale: 0.95, autoAlpha: 0, duration: 0.45, ease: "power2.in" }, 0);
        tl.set(outgoing, { autoAlpha: 0, pointerEvents: "none" });
        tl.set(incoming, { autoAlpha: 1, pointerEvents: "auto" }, 0.25);
        tl.fromTo(
          inBits,
          { y: 22, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: 0.6, stagger: 0.05, ease: "power3.out" },
          0.28,
        );
        tl.fromTo(
          inMedia,
          { y: 28, scale: 0.94, autoAlpha: 0 },
          { y: 0, scale: 1, autoAlpha: 1, duration: 0.7, ease: "power3.out" },
          0.26,
        );
      }

      current = next;
      updateCounter(current);
      syncDots(current);
      placeDotsOnActiveSlide();
    }

    function stopAutoplay() {
      if (autoplayTimer !== undefined) window.clearTimeout(autoplayTimer);
      autoplayTimer = undefined;
      stopRing();
    }

    function startAutoplay() {
      if (prefersReducedMotion || slides.length <= 1) return;
      stopAutoplay();
      startRing();
      autoplayTimer = window.setTimeout(() => {
        goTo(current + 1);
        startAutoplay();
      }, AUTOPLAY_MS);
    }

    function jumpTo(index: number) {
      goTo(index);
      startAutoplay();
    }

    if (slides.length > 1) {
      prevBtn?.addEventListener("click", () => jumpTo(current - 1));
      nextBtn?.addEventListener("click", () => jumpTo(current + 1));
      dots.forEach((dot, i) => dot.addEventListener("click", () => jumpTo(i)));

      // En desktop pausar al hover; en móvil no (no hay mouse)
      if (desktopMq.matches) {
        root.addEventListener("mouseenter", stopAutoplay);
        root.addEventListener("mouseleave", startAutoplay);
      }

      let touchStartX = 0;
      root.addEventListener(
        "touchstart",
        (event) => {
          touchStartX = event.touches[0]?.clientX ?? 0;
          stopAutoplay();
        },
        { passive: true },
      );
      root.addEventListener(
        "touchend",
        (event) => {
          const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
          const delta = touchEndX - touchStartX;
          if (Math.abs(delta) > 40) {
            goTo(delta < 0 ? current + 1 : current - 1);
          }
          startAutoplay();
        },
        { passive: true },
      );

      syncDots(0);
      placeDotsOnActiveSlide();
      startAutoplay();
    }
  }

  document.querySelectorAll<HTMLElement>("[data-showcase]").forEach(initShowcase);
</script>
