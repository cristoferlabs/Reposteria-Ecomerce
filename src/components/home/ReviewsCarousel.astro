---
// La tabla `reviews` ya existe en el schema del backend pero todavía no
// tiene datos sembrados ni un endpoint de lectura — este componente queda
// listo para consumirla vía prop `reviews` en cuanto exista esa pieza
// (pedirla a la sesión de backend, no improvisar una query directa acá).
// Mientras tanto, usa reseñas de ejemplo claramente reemplazables.

interface Review {
  id: string | number;
  customerName: string;
  rating: number;
  comment: string;
  productName?: string;
  verified?: boolean;
}

const EXAMPLE_REVIEWS: Review[] = [
  {
    id: "ejemplo-1",
    customerName: "Valeria M.",
    rating: 5,
    comment: "El cheesecake llegó impecable y el sabor superó lo que esperaba. Se los recomendé a toda mi familia.",
    productName: "Cheesecake",
    verified: true,
  },
  {
    id: "ejemplo-2",
    customerName: "Jorge R.",
    rating: 5,
    comment: "Pedí una torta de chocolate para el cumpleaños de mi hija con poco tiempo de anticipación y quedó hermosa.",
    productName: "Torta de Chocolate",
    verified: true,
  },
  {
    id: "ejemplo-3",
    customerName: "Camila S.",
    rating: 4,
    comment: "Muy rico el pie de moras, justo de dulce. La entrega llegó puntual al punto que elegí.",
    productName: "Pie de Moras",
    verified: true,
  },
  {
    id: "ejemplo-4",
    customerName: "Diego H.",
    rating: 5,
    comment: "La atención por WhatsApp fue clara en todo momento y el pionono de oreo es adictivo.",
    productName: "Pionono de Oreo",
    verified: true,
  },
];

interface Props {
  reviews?: Review[];
}

const { reviews } = Astro.props;
const items = reviews && reviews.length > 0 ? reviews : EXAMPLE_REVIEWS;
const averageRating = items.reduce((sum, r) => sum + r.rating, 0) / items.length;
---

<section class="bg-neutral-50 px-4 py-16 sm:py-20" data-reveal>
  <div class="mx-auto max-w-6xl">
    <div class="text-center">
      <p class="font-body text-xs font-semibold tracking-widest text-pink-strong uppercase">Lo que dicen de nosotros</p>
      <div class="mt-3 flex items-center justify-center gap-2">
        <div class="flex text-gold" aria-hidden="true">
          {
            Array.from({ length: 5 }).map((_, i) => (
              <svg viewBox="0 0 20 20" fill={i < Math.round(averageRating) ? "currentColor" : "none"} stroke="currentColor" class="h-5 w-5">
                <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L10 1.5z" stroke-linejoin="round" />
              </svg>
            ))
          }
        </div>
        <span class="font-body text-sm font-semibold text-charcoal">{averageRating.toFixed(1)}</span>
        <span class="font-body text-sm text-charcoal/60">· {items.length} reseña{items.length === 1 ? "" : "s"}</span>
      </div>
    </div>

    <div class="relative mt-10">
      <div
        id="reviews-track"
        class="flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        data-reveal-group
      >
        {
          items.map((review) => (
            <article
              class="w-[85%] shrink-0 snap-start rounded-2xl border border-charcoal/10 bg-white p-6 shadow-sm transition-shadow duration-200 hover:shadow-md sm:w-[380px]"
              data-reveal-item
            >
              <div class="flex text-gold" aria-hidden="true">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg viewBox="0 0 20 20" fill={i < review.rating ? "currentColor" : "none"} stroke="currentColor" class="h-4 w-4">
                    <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L10 1.5z" stroke-linejoin="round" />
                  </svg>
                ))}
              </div>
              <p class="mt-4 font-body text-sm leading-relaxed text-charcoal/80">"{review.comment}"</p>
              <div class="mt-5 flex items-center justify-between border-t border-charcoal/10 pt-4">
                <div>
                  <p class="flex items-center gap-1.5 font-body text-sm font-semibold text-charcoal">
                    {review.customerName}
                    {review.verified && (
                      <span class="flex h-4 w-4 items-center justify-center rounded-full bg-emerald-100 text-emerald-700" aria-label="Compra verificada">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="h-2.5 w-2.5">
                          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    )}
                  </p>
                  {review.productName && <p class="text-xs text-charcoal/50">Compró: {review.productName}</p>}
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-4 flex justify-center gap-3">
        <button
          type="button"
          id="reviews-prev"
          aria-label="Reseña anterior"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-charcoal/20 text-charcoal transition-colors hover:bg-pink-soft/30"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          type="button"
          id="reviews-next"
          aria-label="Siguiente reseña"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-charcoal/20 text-charcoal transition-colors hover:bg-pink-soft/30"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
            <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("reviews-track");
  const prevBtn = document.getElementById("reviews-prev");
  const nextBtn = document.getElementById("reviews-next");

  function scrollByCard(direction: number) {
    if (!track) return;
    const card = track.querySelector<HTMLElement>("article");
    const amount = (card?.offsetWidth ?? 320) + 20;
    track.scrollBy({ left: amount * direction, behavior: "smooth" });
  }

  prevBtn?.addEventListener("click", () => scrollByCard(-1));
  nextBtn?.addEventListener("click", () => scrollByCard(1));
</script>
