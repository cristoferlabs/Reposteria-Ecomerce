---
import { eq } from "drizzle-orm";
import { db } from "../../db/client";
import { products } from "../../db/schema";

// La imagen de cada tarjeta es la foto del producto destacado (o el primero
// activo) de esa categoría — el schema no tiene una imagen propia por
// categoría todavía.
const categoriesWithProducts = await db.query.categories.findMany({
  orderBy: (categories, { asc }) => [asc(categories.sortOrder)],
  with: {
    products: {
      where: eq(products.active, true),
      orderBy: (products, { desc }) => [desc(products.featured)],
    },
  },
});

const tiles = categoriesWithProducts
  .filter((cat) => cat.products.length > 0)
  .map((cat) => ({
    slug: cat.slug,
    name: cat.name,
    count: cat.products.length,
    image: cat.products[0].imageUrl,
  }));
---

{
  tiles.length > 0 && (
    <section class="bg-charcoal px-4 py-16 sm:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="text-center">
          <p class="font-body text-xs font-semibold tracking-widest text-gold uppercase">Explora</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-white sm:text-4xl">¿Qué se te antoja hoy?</h2>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {tiles.map((tile) => (
            <a href={`/catalogo/${tile.slug}`} class="group relative block overflow-hidden rounded-2xl">
              <img
                src={tile.image}
                alt={tile.name}
                loading="lazy"
                class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-charcoal/85 via-charcoal/10 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 flex items-end justify-between p-5">
                <div>
                  <p class="font-display text-xl font-semibold text-white">{tile.name}</p>
                  <p class="mt-1 font-body text-sm text-white/70">
                    {tile.count} producto{tile.count === 1 ? "" : "s"}
                  </p>
                </div>
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white text-charcoal transition-all duration-200 group-hover:-translate-y-1 group-hover:bg-pink-strong group-hover:text-white">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                    <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
