---
import { loadCategoriesWithActiveProducts } from "../../db/queries";

// La imagen de cada tarjeta es la foto del producto destacado (o el primero
// activo) de esa categoría — el schema no tiene una imagen propia por
// categoría todavía.
const categoriesWithProducts = await loadCategoriesWithActiveProducts();

const tiles = categoriesWithProducts
  .filter((cat) => cat.products.length > 0)
  .map((cat) => ({
    slug: cat.slug,
    name: cat.name,
    count: cat.products.length,
    image: cat.products[0].imageUrl,
  }));
---

{
  tiles.length > 0 && (
    <section class="bg-white px-4 py-16 sm:py-20" data-reveal>
      <div class="mx-auto max-w-6xl">
        <div class="text-center">
          <p class="font-body text-xs font-semibold tracking-widest text-pink-strong uppercase">Explora</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-charcoal sm:text-4xl">¿Qué se te antoja hoy?</h2>
        </div>

        <div class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-3" data-reveal-group>
          {tiles.map((tile) => (
            <a href={`/catalogo/${tile.slug}`} class="group block" data-reveal-item>
              <div class="overflow-hidden rounded-2xl bg-neutral-100">
                <img
                  src={tile.image}
                  alt={tile.name}
                  loading="lazy"
                  class="aspect-[3/4] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <p class="mt-4 font-display text-lg font-semibold text-charcoal transition-colors group-hover:text-pink-strong">
                {tile.name}
              </p>
              <p class="mt-1 font-body text-sm text-charcoal/60">
                {tile.count} producto{tile.count === 1 ? "" : "s"}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
