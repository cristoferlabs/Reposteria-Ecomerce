---
// Motor de scroll-reveal para todo el sitio: cualquier sección con
// data-reveal, o item con data-reveal-item dentro de un contenedor con
// data-reveal-group (para el stagger), aparece con fade + slide sutil al
// entrar en viewport. Se monta una sola vez en BaseLayout.
---

<script>
  function initScrollReveal() {
    const items = document.querySelectorAll<HTMLElement>("[data-reveal], [data-reveal-item]");
    if (items.length === 0) return;

    // Recién ahora, con JS listo, activamos el CSS que los oculta antes de
    // animarlos — así si este script no corre (o tarda), el contenido
    // arranca visible en vez de escondido para siempre.
    document.documentElement.classList.add("js-reveal-ready");

    document.querySelectorAll<HTMLElement>("[data-reveal-group]").forEach((group) => {
      group.querySelectorAll<HTMLElement>("[data-reveal-item]").forEach((el, index) => {
        el.style.transitionDelay = `${(index % 6) * 70}ms`;
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -80px 0px" },
    );

    items.forEach((el) => observer.observe(el));
  }

  // En el home, el bloque justo debajo del hero (CategoryTiles) suele estar
  // ya cerca del viewport al cargar — si el observer arrancara de una, se
  // revelaría mientras IntroReveal todavía tapa la pantalla (o apenas
  // termina), sintiéndose desconectado de la entrada del hero en vez de
  // una secuencia. Se espera a que la intro termine (evento "intro-hidden")
  // antes de armar el observer; en el resto del sitio, sin intro, arranca
  // igual que siempre.
  const introEl = document.getElementById("intro-reveal");
  if (introEl && !introEl.classList.contains("intro-hidden")) {
    document.addEventListener("intro-hidden", initScrollReveal, { once: true });
  } else {
    initScrollReveal();
  }
</script>
