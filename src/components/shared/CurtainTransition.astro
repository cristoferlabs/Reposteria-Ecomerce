---
// Transición de página tipo cortina: baja al salir, sube al entrar.
// CSS transitions (fiables) + z-index alto para quedar por encima de nav/tienda/intro.
---

<div id="page-curtain" class="page-curtain" aria-hidden="true">
  <div id="page-curtain-panel" class="page-curtain__panel">
    <div class="page-curtain__fill"></div>
    <svg class="page-curtain__wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path
        fill="currentColor"
        d="M0,0 L1440,0 L1440,38 C1320,92 1180,108 1040,72 C900,36 820,18 700,42 C560,72 420,110 260,96 C140,86 60,58 0,44 Z"
      />
    </svg>
  </div>
</div>

<style is:global>
  .page-curtain {
    position: fixed;
    inset: 0;
    z-index: 99999;
    pointer-events: none;
    visibility: hidden;
    color: #2a2421;
  }

  .page-curtain.is-active {
    visibility: visible;
    pointer-events: auto;
  }

  .page-curtain__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    transform: translate3d(0, -110%, 0);
    will-change: transform;
    transition: transform 0.7s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .page-curtain.is-covering .page-curtain__panel {
    transform: translate3d(0, 0, 0);
  }

  .page-curtain.is-revealing .page-curtain__panel {
    transform: translate3d(0, -110%, 0);
    transition-duration: 0.65s;
  }

  .page-curtain__fill {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: currentColor;
  }

  .page-curtain__wave {
    display: block;
    width: 100%;
    height: clamp(64px, 10vw, 120px);
    margin-top: -1px;
    color: inherit;
  }

  .page-curtain__wave path {
    fill: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-curtain__panel {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const STORAGE_KEY = "arlet-curtain";
  const COVER_MS = 720;
  const REVEAL_MS = 680;

  function initCurtain() {
    const root = document.getElementById("page-curtain");
    const panel = document.getElementById("page-curtain-panel");
    if (!root || !panel) return;
    if (root.dataset.curtainInit === "true") return;
    root.dataset.curtainInit = "true";

    let busy = false;

    function wait(ms: number) {
      return new Promise<void>((resolve) => window.setTimeout(resolve, ms));
    }

    function cover(): Promise<void> {
      root.classList.remove("is-revealing", "is-covering");
      root.classList.add("is-active");
      // Pintar un frame arriba (fuera de pantalla) y luego bajar
      void panel.offsetHeight;
      root.classList.add("is-covering");
      return wait(COVER_MS);
    }

    function reveal(): Promise<void> {
      root.classList.add("is-active", "is-covering");
      void panel.offsetHeight;
      root.classList.add("is-revealing");
      root.classList.remove("is-covering");
      return wait(REVEAL_MS).then(() => {
        root.classList.remove("is-active", "is-revealing", "is-covering");
      });
    }

    // Llegada: cortina tapando → subir
    if (sessionStorage.getItem(STORAGE_KEY) === "1") {
      sessionStorage.removeItem(STORAGE_KEY);
      root.classList.add("is-active", "is-covering");
      // Sin transición en el frame inicial (ya cubierto)
      panel.style.transition = "none";
      void panel.offsetHeight;
      requestAnimationFrame(() => {
        panel.style.transition = "";
        void reveal();
      });
    }

    function isInternalNav(anchor: HTMLAnchorElement): boolean {
      if (anchor.hasAttribute("data-no-curtain")) return false;
      if (anchor.target && anchor.target !== "_self") return false;
      if (anchor.hasAttribute("download")) return false;

      const href = anchor.getAttribute("href");
      if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) {
        return false;
      }

      let url: URL;
      try {
        url = new URL(href, window.location.href);
      } catch {
        return false;
      }

      if (url.origin !== window.location.origin) return false;
      if (url.pathname.startsWith("/api/")) return false;
      if (url.pathname === window.location.pathname && url.search === window.location.search) return false;
      return true;
    }

    async function navigateWithCurtain(href: string) {
      if (busy) return;
      busy = true;
      try {
        await cover();
        sessionStorage.setItem(STORAGE_KEY, "1");
        window.location.assign(href);
      } catch {
        busy = false;
        window.location.assign(href);
      }
    }

    document.addEventListener(
      "click",
      (event) => {
        if (event.defaultPrevented) return;
        if (event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const target = event.target;
        if (!(target instanceof Element)) return;

        const anchor = target.closest("a");
        if (!anchor || !(anchor instanceof HTMLAnchorElement)) return;
        if (!isInternalNav(anchor)) return;

        event.preventDefault();
        event.stopPropagation();
        void navigateWithCurtain(anchor.href);
      },
      true,
    );

    window.addEventListener("arlet:navigate", ((event: CustomEvent<{ href: string }>) => {
      const href = event.detail?.href;
      if (!href) return;
      void navigateWithCurtain(href);
    }) as EventListener);

    window.addEventListener("pageshow", (event) => {
      if (event.persisted && sessionStorage.getItem(STORAGE_KEY) === "1") {
        sessionStorage.removeItem(STORAGE_KEY);
        root.classList.add("is-active", "is-covering");
        panel.style.transition = "none";
        void panel.offsetHeight;
        requestAnimationFrame(() => {
          panel.style.transition = "";
          void reveal();
        });
      }
    });
  }

  initCurtain();
  document.addEventListener("astro:page-load", initCurtain);
</script>
