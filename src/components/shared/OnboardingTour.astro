---
// Tour de onboarding: carrusel de pasos en un modal, mismo patrón visual de
// overlay+panel con fade que ya usan QuickViewModal.astro/CartDrawer.astro.
// Se monta una sola vez en BaseLayout. Se abre solo en la primera visita
// (localStorage) y se puede reabrir a mano disparando el evento "open-tour"
// en document (mismo patrón que "open-cart"/"open-quick-view") — el trigger
// manual vive en Footer.astro ("¿Cómo funciona?").
---

<div
  id="tour-overlay"
  class="invisible fixed inset-0 z-70 flex items-center justify-center bg-charcoal/60 p-4 opacity-0 transition-opacity duration-200"
>
  <div
    id="tour-panel"
    class="w-full max-w-md translate-y-2 scale-95 rounded-2xl bg-white p-6 shadow-2xl transition-all duration-200 sm:p-8"
  >
    <div class="flex items-start justify-between">
      <p class="font-body text-xs font-semibold tracking-widest text-pink-strong uppercase">Cómo funciona</p>
      <button
        type="button"
        id="tour-close"
        aria-label="Cerrar"
        class="rounded-full p-1 text-charcoal/50 transition-colors hover:bg-charcoal/5 hover:text-charcoal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="mt-6 flex justify-center">
      <span id="tour-icon" class="flex h-14 w-14 items-center justify-center rounded-full bg-pink-soft/40 text-pink-strong"></span>
    </div>
    <h3 id="tour-title" class="mt-4 text-center font-display text-xl font-semibold text-charcoal"></h3>
    <p id="tour-description" class="mt-2 text-center text-sm leading-relaxed text-charcoal/70"></p>

    <div id="tour-dots" class="mt-6 flex justify-center gap-1.5"></div>

    <div class="mt-6 flex items-center justify-between gap-3">
      <button type="button" id="tour-skip" class="font-body text-sm font-medium text-charcoal/50 hover:text-charcoal">
        Saltar
      </button>
      <div class="flex gap-2">
        <button
          type="button"
          id="tour-prev"
          class="rounded-full border border-charcoal/20 px-4 py-2 font-body text-sm font-semibold text-charcoal transition-colors hover:bg-charcoal/5"
        >
          Anterior
        </button>
        <button
          type="button"
          id="tour-next"
          class="rounded-full bg-pink-strong px-5 py-2 font-body text-sm font-semibold text-white transition-colors hover:bg-charcoal"
        >
          Siguiente
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  interface TourStep {
    icon: string;
    title: string;
    description: string;
  }

  const ICONS = {
    browse: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3" stroke-linecap="round"/></svg>',
    cart: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7"><path d="M6 8h12l-1 12H7L6 8Z" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 0 1 6 0v2" stroke-linecap="round"/></svg>',
    send: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7"><path d="m3 11 18-8-8 18-2-8-8-2Z" stroke-linejoin="round"/></svg>',
    review: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7"><path d="M8 12h8M8 16h5M21 12c0 4.4-4 8-9 8-1.3 0-2.6-.2-3.7-.7L3 20l1-4.2C3.4 14.5 3 13.3 3 12c0-4.4 4-8 9-8s9 3.6 9 8Z" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    payment: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20" stroke-linecap="round"/></svg>',
    tracking: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7"><circle cx="12" cy="10" r="3"/><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z" stroke-linejoin="round"/></svg>',
    delivered: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-7 w-7"><path d="M20 7 12 3 4 7v10l8 4 8-4V7Z" stroke-linejoin="round"/><path d="M4 7l8 4 8-4M12 11v10" stroke-linejoin="round"/></svg>',
  };

  const STEPS: TourStep[] = [
    { icon: ICONS.browse, title: "Explorá el catálogo", description: "Mirá tortas, cupcakes, galletas y más, sin necesidad de crear una cuenta todavía." },
    { icon: ICONS.cart, title: "Armá tu pedido", description: "El carrito es un panel rápido que se abre al costado, no una página aparte — agregá todo lo que quieras desde ahí." },
    { icon: ICONS.send, title: "Enviá tu solicitud", description: "Elegí la fecha que necesitás y mandala. No es una compra inmediata: es un pedido a medida." },
    { icon: ICONS.review, title: "El repostero la revisa", description: "Puede tomarla tal cual la pediste, o proponerte un ajuste de precio o fecha que vos decidís si aceptar." },
    { icon: ICONS.payment, title: "Elegís entrega y pagás", description: "Contraentrega (50% ahora + 50% al recibir) o tu propio delivery (100% por adelantado), con Mercado Pago." },
    { icon: ICONS.tracking, title: "Seguí tu pedido", description: "Un seguimiento paso a paso te muestra en qué etapa está, desde que lo enviás hasta que lo recibís." },
    { icon: ICONS.delivered, title: "¡Listo!", description: "Recibís tu pedido — y si elegiste contraentrega, pagás el saldo en ese momento." },
  ];

  const SEEN_KEY = "arlet-tour-seen";

  const overlay = document.getElementById("tour-overlay");
  const panel = document.getElementById("tour-panel");
  const iconEl = document.getElementById("tour-icon");
  const titleEl = document.getElementById("tour-title");
  const descEl = document.getElementById("tour-description");
  const dotsEl = document.getElementById("tour-dots");
  const prevBtn = document.getElementById("tour-prev");
  const nextBtn = document.getElementById("tour-next");
  const skipBtn = document.getElementById("tour-skip");
  const closeBtn = document.getElementById("tour-close");

  let current = 0;

  function render() {
    const step = STEPS[current];
    if (iconEl) iconEl.innerHTML = step.icon;
    if (titleEl) titleEl.textContent = step.title;
    if (descEl) descEl.textContent = step.description;
    if (dotsEl) {
      dotsEl.innerHTML = STEPS.map(
        (_, i) => `<span class="h-1.5 w-1.5 rounded-full ${i === current ? "bg-pink-strong" : "bg-charcoal/15"}"></span>`,
      ).join("");
    }
    prevBtn?.classList.toggle("invisible", current === 0);
    if (nextBtn) nextBtn.textContent = current === STEPS.length - 1 ? "Empezar a explorar" : "Siguiente";
  }

  function openTour() {
    if (!overlay || !panel) return;
    current = 0;
    render();
    overlay.classList.remove("invisible", "opacity-0");
    overlay.classList.add("opacity-100");
    panel.classList.remove("translate-y-2", "scale-95");
    panel.classList.add("translate-y-0", "scale-100");
    document.body.classList.add("overflow-hidden");
  }

  function closeTour() {
    if (!overlay || !panel) return;
    overlay.classList.add("opacity-0");
    overlay.classList.remove("opacity-100");
    panel.classList.add("translate-y-2", "scale-95");
    panel.classList.remove("translate-y-0", "scale-100");
    document.body.classList.remove("overflow-hidden");
    window.setTimeout(() => overlay.classList.add("invisible"), 200);
  }

  nextBtn?.addEventListener("click", () => {
    if (current === STEPS.length - 1) {
      closeTour();
      return;
    }
    current++;
    render();
  });
  prevBtn?.addEventListener("click", () => {
    if (current === 0) return;
    current--;
    render();
  });
  skipBtn?.addEventListener("click", closeTour);
  closeBtn?.addEventListener("click", closeTour);
  overlay?.addEventListener("click", (event) => {
    if (event.target === overlay) closeTour();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeTour();
  });
  document.addEventListener("open-tour", openTour);

  if (!localStorage.getItem(SEEN_KEY)) {
    localStorage.setItem(SEEN_KEY, "1");
    window.setTimeout(openTour, 600);
  }
</script>
