---
// Tour de onboarding tipo "coach mark": en vez de un modal que tapa la
// pantalla y solo narra los pasos, señala el elemento real de la interfaz
// (navbar, botón de vista rápida, carrito, mis pedidos) con un spotlight +
// una tarjeta flotante al lado, y hace scroll con transición hasta cada uno.
// Los pasos que no corresponden a algo visible en esta página (revisión del
// repostero, pago, ya que ocurren en otro momento/pantalla) se muestran como
// tarjeta centrada, misma UI, sin spotlight.
// Se monta una sola vez en BaseLayout. Se abre solo en la primera visita
// (localStorage) y se puede reabrir a mano disparando el evento "open-tour"
// en document (mismo patrón que "open-cart"/"open-quick-view") — el trigger
// manual vive en Footer.astro ("¿Cómo funciona?").
---

<div id="tour-root" class="fixed inset-0 z-70 hidden">
  <!-- Un solo elemento hace de spotlight: su box-shadow gigante oscurece
       todo menos su propio rectángulo, que se mueve con transición hasta
       calzar sobre el elemento real señalado (o cubre toda la pantalla
       cuando el paso no tiene un elemento al que apuntar). -->
  <div id="tour-spotlight" class="pointer-events-none fixed rounded-2xl transition-all duration-300 ease-out"></div>

  <div
    id="tour-card"
    class="pointer-events-auto fixed w-[min(90vw,20rem)] rounded-2xl bg-white p-5 shadow-2xl transition-all duration-300 ease-out"
  >
    <div class="flex items-start justify-between gap-3">
      <p id="tour-step-label" class="font-body text-xs font-semibold tracking-widest text-pink-strong uppercase"></p>
      <button
        type="button"
        id="tour-close"
        aria-label="Cerrar"
        class="-m-1 shrink-0 rounded-full p-1 text-charcoal/50 transition-colors hover:bg-charcoal/5 hover:text-charcoal"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <h3 id="tour-title" class="mt-2 font-display text-lg font-semibold text-charcoal"></h3>
    <p id="tour-description" class="mt-1.5 text-sm leading-relaxed text-charcoal/70"></p>

    <div id="tour-dots" class="mt-4 flex gap-1.5"></div>

    <div class="mt-4 flex items-center justify-between gap-3">
      <button type="button" id="tour-skip" class="font-body text-xs font-medium text-charcoal/50 hover:text-charcoal">
        Saltar tour
      </button>
      <div class="flex gap-2">
        <button
          type="button"
          id="tour-prev"
          class="rounded-full border border-charcoal/20 px-3 py-1.5 font-body text-xs font-semibold text-charcoal transition-colors hover:bg-charcoal/5"
        >
          Anterior
        </button>
        <button
          type="button"
          id="tour-next"
          class="rounded-full bg-pink-strong px-4 py-1.5 font-body text-xs font-semibold text-white transition-colors hover:bg-charcoal"
        >
          Siguiente
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  interface TourStep {
    title: string;
    description: string;
    /** Selector CSS del elemento real a señalar. Si falta, o el elemento no
     * está visible en esta página/tamaño de pantalla, el paso se muestra
     * como tarjeta centrada sin spotlight. */
    target?: string;
  }

  const STEPS: TourStep[] = [
    {
      title: "Explorá el catálogo",
      description: "Abrí este menú para ver las categorías con fotos y precios reales, sin necesidad de crear una cuenta todavía.",
      target: "#nav-dropdown-toggle",
    },
    {
      title: "Vista rápida, sin cambiar de pantalla",
      description: 'Este botón abre foto, variantes y "Agregar a mi pedido" ahí mismo, sin salir de donde estás.',
      target: ".quick-view-trigger",
    },
    {
      title: "Tu pedido se arma acá",
      description: "Cada cosa que agregás aparece en este panel — es un carrito rápido, no una página aparte.",
      target: "#cart-toggle",
    },
    {
      title: "Envías la solicitud",
      description: "Elegís la fecha que necesitás y la mandás desde el carrito. No es una compra inmediata: es un pedido a medida.",
    },
    {
      title: "El repostero la revisa",
      description: "Puede tomarla tal cual la pediste, o proponerte un ajuste de precio o fecha que vos decidís si aceptar.",
    },
    {
      title: "Elegís entrega y pagás",
      description: "Contraentrega (50% ahora + 50% al recibir) o tu propio delivery (100% por adelantado), con Mercado Pago.",
    },
    {
      title: "Seguís tu pedido acá",
      description: '"Mis pedidos" te muestra en qué etapa está, paso a paso, hasta que lo recibís.',
      target: "#orders-toggle",
    },
    {
      title: "¡Listo!",
      description: "Ya sabés cómo funciona. Explorá el catálogo cuando quieras — este tour vuelve a estar disponible desde el pie de página.",
    },
  ];

  const SEEN_KEY = "arlet-tour-seen";
  const SPOTLIGHT_COLOR = "46, 35, 32"; // --color-charcoal en rgb, para el rgba() del dim
  const RING_COLOR = "#e4568a"; // --color-pink-strong
  const PAD = 10;
  const GAP = 14;

  const root = document.getElementById("tour-root");
  const spotlight = document.getElementById("tour-spotlight");
  const card = document.getElementById("tour-card");
  const stepLabelEl = document.getElementById("tour-step-label");
  const titleEl = document.getElementById("tour-title");
  const descEl = document.getElementById("tour-description");
  const dotsEl = document.getElementById("tour-dots");
  const prevBtn = document.getElementById("tour-prev");
  const nextBtn = document.getElementById("tour-next");
  const skipBtn = document.getElementById("tour-skip");
  const closeBtn = document.getElementById("tour-close");

  let current = 0;
  let isOpen = false;
  let repositionTimer: number | undefined;

  function findVisibleTarget(selector?: string): HTMLElement | null {
    if (!selector) return null;
    const el = document.querySelector<HTMLElement>(selector);
    if (!el) return null;
    const rect = el.getBoundingClientRect();
    // Un ancestro con "hidden" (ej. el botón de "Mis pedidos" en mobile, o
    // el dropdown de categorías fuera del breakpoint md) devuelve un rect
    // en 0 — se trata igual que "no existe" y cae al modo centrado.
    if (rect.width === 0 && rect.height === 0) return null;
    return el;
  }

  function positionOnTarget(el: HTMLElement) {
    if (!spotlight || !card) return;
    const rect = el.getBoundingClientRect();

    spotlight.style.top = `${rect.top - PAD}px`;
    spotlight.style.left = `${rect.left - PAD}px`;
    spotlight.style.width = `${rect.width + PAD * 2}px`;
    spotlight.style.height = `${rect.height + PAD * 2}px`;
    spotlight.style.boxShadow = `0 0 0 3px ${RING_COLOR}, 0 0 0 9999px rgba(${SPOTLIGHT_COLOR}, 0.55)`;
    spotlight.style.background = "transparent";

    // Se calcula debajo del target primero; si no entra, arriba. Se centra
    // horizontalmente sobre el target, dentro de los márgenes del viewport.
    const cardRect = card.getBoundingClientRect();
    const spaceBelow = window.innerHeight - rect.bottom;
    const placeAbove = spaceBelow < cardRect.height + GAP + 16 && rect.top > cardRect.height + GAP + 16;

    const top = placeAbove ? rect.top - cardRect.height - GAP : rect.bottom + GAP;
    const idealLeft = rect.left + rect.width / 2 - cardRect.width / 2;
    const left = Math.min(Math.max(idealLeft, 16), window.innerWidth - cardRect.width - 16);

    card.style.top = `${Math.min(Math.max(top, 16), window.innerHeight - cardRect.height - 16)}px`;
    card.style.left = `${left}px`;
    card.style.transform = "none";
  }

  function positionCentered() {
    if (!spotlight || !card) return;
    spotlight.style.top = "0";
    spotlight.style.left = "0";
    spotlight.style.width = "100vw";
    spotlight.style.height = "100vh";
    spotlight.style.boxShadow = "none";
    spotlight.style.background = `rgba(${SPOTLIGHT_COLOR}, 0.55)`;

    card.style.top = "50%";
    card.style.left = "50%";
    card.style.transform = "translate(-50%, -50%)";
  }

  function updatePosition() {
    const step = STEPS[current];
    const target = findVisibleTarget(step.target);
    if (target) {
      positionOnTarget(target);
    } else {
      positionCentered();
    }
  }

  function render() {
    const step = STEPS[current];
    if (stepLabelEl) stepLabelEl.textContent = `Cómo funciona · ${current + 1} de ${STEPS.length}`;
    if (titleEl) titleEl.textContent = step.title;
    if (descEl) descEl.textContent = step.description;
    if (dotsEl) {
      dotsEl.innerHTML = STEPS.map(
        (_, i) => `<span class="h-1.5 flex-1 rounded-full ${i === current ? "bg-pink-strong" : "bg-charcoal/15"}"></span>`,
      ).join("");
    }
    prevBtn?.classList.toggle("invisible", current === 0);
    if (nextBtn) nextBtn.textContent = current === STEPS.length - 1 ? "Entendido" : "Siguiente";

    const target = findVisibleTarget(step.target);
    if (target) {
      // Transición real: primero se hace scroll hacia el elemento, y recién
      // cuando termina de moverse se reposiciona el spotlight/tarjeta sobre
      // su ubicación final — así se ve como "bajar" hasta cada opción, no un
      // salto instantáneo.
      target.scrollIntoView({ behavior: "smooth", block: "center" });
      window.clearTimeout(repositionTimer);
      repositionTimer = window.setTimeout(updatePosition, 380);
    } else {
      window.clearTimeout(repositionTimer);
      updatePosition();
    }
  }

  function openTour() {
    if (!root) return;
    isOpen = true;
    current = 0;
    root.classList.remove("hidden");
    render();
    window.addEventListener("scroll", updatePosition, { passive: true });
    window.addEventListener("resize", updatePosition);
  }

  function closeTour() {
    if (!root) return;
    isOpen = false;
    root.classList.add("hidden");
    window.clearTimeout(repositionTimer);
    window.removeEventListener("scroll", updatePosition);
    window.removeEventListener("resize", updatePosition);
  }

  nextBtn?.addEventListener("click", () => {
    if (current === STEPS.length - 1) {
      closeTour();
      return;
    }
    current++;
    render();
  });
  prevBtn?.addEventListener("click", () => {
    if (current === 0) return;
    current--;
    render();
  });
  skipBtn?.addEventListener("click", closeTour);
  closeBtn?.addEventListener("click", closeTour);
  document.addEventListener("keydown", (event) => {
    if (isOpen && event.key === "Escape") closeTour();
  });
  document.addEventListener("open-tour", openTour);

  if (!localStorage.getItem(SEEN_KEY)) {
    localStorage.setItem(SEEN_KEY, "1");
    window.setTimeout(openTour, 600);
  }
</script>
