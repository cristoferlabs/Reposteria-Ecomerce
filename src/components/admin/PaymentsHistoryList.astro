---
import { formatSoles } from "../../lib/orders/pricing";

interface Payment {
  id: number;
  type: "inicial" | "final";
  amountCents: number;
  method: string;
  status: string;
  mpPaymentId: string | null;
  createdAt: string;
}

interface Props {
  payments: Payment[];
}

const { payments } = Astro.props;

const METHOD_LABELS: Record<string, string> = {
  mercado_pago: "Mercado Pago",
  efectivo: "Efectivo",
  yape: "Yape",
  plin: "Plin",
  otro: "Otro",
};

const STATUS_LABELS: Record<string, string> = {
  pendiente: "Pendiente",
  aprobado: "Aprobado",
  rechazado: "Rechazado",
};

const STATUS_CLASSES: Record<string, string> = {
  pendiente: "text-amber-600",
  aprobado: "text-emerald-700",
  rechazado: "text-red-600",
};
---

{
  payments.length === 0 ? (
    <p class="text-sm text-charcoal/50">Sin pagos registrados todavía.</p>
  ) : (
    <ul class="space-y-2">
      {payments.map((p) => (
        <li class="flex items-center justify-between rounded-lg border border-charcoal/10 px-3 py-2 text-sm">
          <div>
            <p class="font-medium text-charcoal">
              {p.type === "inicial" ? "Pago inicial" : "Pago final"} · {METHOD_LABELS[p.method] ?? p.method}
            </p>
            <p class="text-xs text-charcoal/50">
              {new Date(p.createdAt).toLocaleString("es-PE")}
              {p.mpPaymentId && ` · MP #${p.mpPaymentId}`}
            </p>
          </div>
          <div class="text-right">
            <p class="font-semibold text-charcoal">{formatSoles(p.amountCents)}</p>
            <p class={`text-xs ${STATUS_CLASSES[p.status] ?? "text-charcoal"}`}>{STATUS_LABELS[p.status] ?? p.status}</p>
          </div>
        </li>
      ))}
    </ul>
  )
}
