# ── Sitio ──────────────────────────────────────────────────────────────────
# URL pública final (subdominio en Namecheap). Usada para sitemap, canonical
# tags, redirect_uri de Google y metadata Open Graph.
PUBLIC_SITE_URL=https://tienda.tudominio.com

# ── Base de datos (MySQL) ────────────────────────────────────────────────────
# En local: el MySQL que corre en tu máquina (el mismo que ves en DBeaver).
# En producción: las credenciales que genera cPanel en "MySQL Databases"
# (ahí también creas la base y el usuario, y los asocias — cPanel no acepta
# una connection string única, siempre son estos 5 campos por separado).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reposteria_dev

# ── Mercado Pago (Checkout Pro) ─────────────────────────────────────────────
# Credenciales de producción (o de prueba mientras se desarrolla).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Secreto usado para validar la firma x-signature del webhook (Portal de MP >
# Tu integración > Webhooks > Firma secreta).
MP_WEBHOOK_SECRET=

# ── Autenticación con Google (clientes y admin) ─────────────────────────────
# Creadas en Google Cloud Console > Credenciales > OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con un "Authorized redirect URI" en Google Cloud.
GOOGLE_REDIRECT_URI=https://tienda.tudominio.com/api/auth/google/callback

# Secreto para firmar la cookie de sesión (JWT). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Emails autorizados como repostero/admin, separados por coma.
ADMIN_EMAILS=repostero@tudominio.com

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Número (con código de país, sin '+' ni espacios) al que se arma el link
# wa.me con el detalle del pedido y el pago inicial confirmado.
WHATSAPP_BUSINESS_NUMBER=51999999999
